@model EasyVan.Models.MotoristaFormViewModel

@{
    ViewData["Title"] = "Novo motorista";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para motoristas
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Cadastros</p>
            <h1>Novo motorista</h1>
            <p class="ev-page-head__lead">Cadastre o profissional e a conta que ele usará para acessar as próprias viagens.</p>
        </div>
    </header>

    <form asp-action="Create" method="post" class="ev-form-layout">
        <div class="ev-form-main">
            <div asp-validation-summary="ModelOnly" class="ev-notice ev-notice--danger" role="alert"></div>

            <section class="ev-panel ev-form-section" aria-labelledby="dados-motorista">
                <div class="ev-form-section__head">
                    <h2 id="dados-motorista">Dados do motorista</h2>
                    <p>Nome e e-mail usados nos registros da operação e no acesso ao sistema.</p>
                </div>
                <div class="ev-form-grid">
                    <div class="ev-field">
                        <label asp-for="Nome" class="form-label">Nome completo <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Nome" class="form-control" placeholder="Nome completo" autocomplete="name" />
                        <span asp-validation-for="Nome" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="Email" class="form-label">E-mail <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="motorista@exemplo.com"
                               autocomplete="email" inputmode="email" autocapitalize="none" spellcheck="false" />
                        <span asp-validation-for="Email" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="Telefone" class="form-label">Telefone</label>
                        <input asp-for="Telefone" class="form-control" type="tel" placeholder="(11) 99999-0000"
                               autocomplete="tel" inputmode="tel" data-telefone-brasil maxlength="15" />
                        <p class="ev-hint">DDD + número, com 10 ou 11 dígitos.</p>
                        <span asp-validation-for="Telefone" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="CNH" class="form-label">CNH</label>
                        <input asp-for="CNH" class="form-control" placeholder="11 dígitos" autocomplete="off"
                               inputmode="numeric" data-cnh-brasil maxlength="11" />
                        <p class="ev-hint">Somente números. O dígito verificador é conferido no servidor.</p>
                        <span asp-validation-for="CNH" class="ev-form-validation"></span>
                    </div>
                </div>
            </section>

            <section class="ev-panel ev-form-section" aria-labelledby="conta-motorista">
                <div class="ev-form-section__head">
                    <h2 id="conta-motorista">Conta de acesso</h2>
                    <p>O motorista entra com este e-mail e senha para ver apenas as próprias viagens.</p>
                </div>
                <div class="ev-form-grid">
                    <div class="ev-field">
                        <label asp-for="Senha" class="form-label">Senha</label>
                        <div class="ev-password">
                            <input asp-for="Senha" id="senhaMotorista" class="form-control" type="password"
                                   autocomplete="new-password" placeholder="De 6 a 20 caracteres" />
                            <button type="button" class="ev-password__toggle" data-password-toggle
                                    aria-controls="senhaMotorista" aria-pressed="false" aria-label="Mostrar senha">
                                <partial name="_Icon" model='"eye"' />
                            </button>
                        </div>
                        <span asp-validation-for="Senha" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="ConfirmarSenha" class="form-label">Confirmar senha</label>
                        <div class="ev-password">
                            <input asp-for="ConfirmarSenha" id="senhaMotoristaConfirmacao" class="form-control" type="password"
                                   autocomplete="new-password" placeholder="Repita a senha" />
                            <button type="button" class="ev-password__toggle" data-password-toggle
                                    aria-controls="senhaMotoristaConfirmacao" aria-pressed="false" aria-label="Mostrar senha">
                                <partial name="_Icon" model='"eye"' />
                            </button>
                        </div>
                        <span asp-validation-for="ConfirmarSenha" class="ev-form-validation"></span>
                    </div>
                </div>
                <p class="ev-hint">Se já existir uma conta de motorista com este e-mail e sem vínculo, o cadastro será associado a ela. Nesse caso a senha pode ficar vazia.</p>
            </section>

            <section class="ev-panel ev-form-section" aria-labelledby="situacao-motorista">
                <div class="ev-form-section__head">
                    <h2 id="situacao-motorista">Situação</h2>
                    <p>Define se o motorista pode ser selecionado em novas viagens.</p>
                </div>
                <div class="ev-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <div class="ev-check__text">
                        <label asp-for="Ativo">Motorista ativo</label>
                        <span>Cadastros inativos continuam no histórico, mas não aparecem na criação de viagens.</span>
                    </div>
                </div>
            </section>

            <div class="ev-form-actions">
                <button type="submit" class="btn btn-primary">Cadastrar motorista</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Vínculo com viagens</h2>
                    <p class="mb-0">O cadastro do motorista é usado ao criar uma viagem. Mantenha e-mail e telefone atualizados para contato.</p>
                </div>
            </section>
        </aside>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
