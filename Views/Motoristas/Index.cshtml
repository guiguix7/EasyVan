@model IEnumerable<EasyVan.Models.Motorista>

@{
    ViewData["Title"] = "Motoristas";
}

<section class="ev-page">
    <header class="ev-page-heading">
        <div>
            <h1>Motoristas</h1>
            <p>Consulte os profissionais cadastrados e a situação de cada cadastro.</p>
        </div>
        <div class="ev-page-actions">
            <a asp-action="Create" class="btn btn-primary">Novo motorista</a>
        </div>
    </header>

    @if (Model.Any())
    {
        <section class="ev-panel d-none d-lg-block p-0 overflow-hidden" aria-label="Tabela de motoristas">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Nome</th><th scope="col">E-mail</th><th scope="col">Telefone</th>
                            <th scope="col">CNH</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var motorista in Model)
                        {
                            <tr>
                                <td><strong>@motorista.Nome</strong></td>
                                <td>@motorista.Email</td>
                                <td>@motorista.Telefone</td>
                                <td>@motorista.CNH</td>
                                <td><span class="badge @(motorista.Ativo ? "badge-status-operacional" : "badge-status-outro")">@(motorista.Ativo ? "Ativo" : "Inativo")</span></td>
                                <td class="text-end tabela-acoes">
                                    <a asp-action="Details" asp-route-id="@motorista.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                                    <a asp-action="Edit" asp-route-id="@motorista.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@motorista.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="ev-mobile-vans d-lg-none" aria-label="Lista de motoristas">
            @foreach (var motorista in Model)
            {
                <article class="ev-van-mobile">
                    <div class="ev-van-mobile__head">
                        <div class="ev-van-mobile__plate">@motorista.Nome</div>
                        <span class="badge @(motorista.Ativo ? "badge-status-operacional" : "badge-status-outro")">@(motorista.Ativo ? "Ativo" : "Inativo")</span>
                    </div>
                    <div class="ev-van-mobile__data">
                        <div class="ev-van-mobile__item"><span>E-mail</span><strong>@motorista.Email</strong></div>
                        <div class="ev-van-mobile__item"><span>Telefone</span><strong>@motorista.Telefone</strong></div>
                        <div class="ev-van-mobile__item"><span>CNH</span><strong>@motorista.CNH</strong></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@motorista.Id" class="btn btn-outline-primary flex-fill">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@motorista.Id" class="btn btn-outline-secondary flex-fill">Editar</a>
                        <a asp-action="Delete" asp-route-id="@motorista.Id" class="btn btn-outline-danger flex-fill">Excluir</a>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <h2 class="h5 mb-2">Nenhum motorista cadastrado</h2>
            <p class="mb-3">Cadastre os motoristas que fazem parte da operação.</p>
            <a asp-action="Create" class="btn btn-primary">Cadastrar motorista</a>
        </div>
    }
</section>
