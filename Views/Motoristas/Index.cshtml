@model IEnumerable<EasyVan.Models.Motorista>

@{
    ViewData["Title"] = "Motoristas";
    var motoristas = Model.ToList();
    var ativos = motoristas.Count(m => m.Ativo);
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Cadastros</p>
            <h1>Motoristas</h1>
            <p class="ev-page-head__lead">Consulte os profissionais cadastrados e a situação de cada um.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-action="Create" class="btn btn-primary">
                <partial name="_Icon" model='"plus"' />
                Novo motorista
            </a>
        </div>
    </header>

    @if (motoristas.Any())
    {
        <div class="ev-results">
            <p class="mb-0">
                <strong>@motoristas.Count</strong> motoristas cadastrados · <strong>@ativos</strong> ativos.
            </p>
        </div>

        <section class="ev-panel ev-panel--flush ev-list-desktop" aria-label="Tabela de motoristas">
            <div class="ev-table-scroll">
                <table class="ev-table">
                    <thead>
                        <tr>
                            <th scope="col">Nome</th>
                            <th scope="col">E-mail</th>
                            <th scope="col">Telefone</th>
                            <th scope="col">CNH</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var motorista in motoristas)
                        {
                            <tr>
                                <td>
                                    <span class="ev-table__primary">@motorista.Nome</span>
                                    <span class="ev-table__secondary">Motorista #@motorista.Id</span>
                                </td>
                                <td>@motorista.Email</td>
                                <td>@(string.IsNullOrWhiteSpace(motorista.Telefone) ? "—" : motorista.Telefone)</td>
                                <td class="is-numeric">@(string.IsNullOrWhiteSpace(motorista.CNH) ? "—" : motorista.CNH)</td>
                                <td><partial name="_StatusBadge" model='motorista.Ativo ? "Ativo" : "Inativo"' /></td>
                                <td class="is-actions">
                                    <div class="ev-row-actions">
                                        <a asp-action="Details" asp-route-id="@motorista.Id" class="ev-link-action">Detalhes</a>
                                        <a asp-action="Edit" asp-route-id="@motorista.Id" class="ev-link-action">
                                            <partial name="_Icon" model='"edit"' />
                                            Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@motorista.Id" class="ev-link-action ev-link-action--danger">
                                            <partial name="_Icon" model='"trash"' />
                                            Excluir
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-records ev-list-mobile" aria-label="Lista de motoristas">
            @foreach (var motorista in motoristas)
            {
                <article class="ev-record">
                    <div class="ev-record__head">
                        <div>
                            <h2 class="ev-record__title">@motorista.Nome</h2>
                            <span class="ev-record__meta">Motorista #@motorista.Id</span>
                        </div>
                        <partial name="_StatusBadge" model='motorista.Ativo ? "Ativo" : "Inativo"' />
                    </div>
                    <dl class="ev-record__data">
                        <div>
                            <dt>E-mail</dt>
                            <dd>@motorista.Email</dd>
                        </div>
                        <div>
                            <dt>Telefone</dt>
                            <dd>@(string.IsNullOrWhiteSpace(motorista.Telefone) ? "Não informado" : motorista.Telefone)</dd>
                        </div>
                        <div class="ev-span-2">
                            <dt>CNH</dt>
                            <dd>@(string.IsNullOrWhiteSpace(motorista.CNH) ? "Não informada" : motorista.CNH)</dd>
                        </div>
                    </dl>
                    <div class="ev-record__actions">
                        <a asp-action="Details" asp-route-id="@motorista.Id" class="btn btn-outline-primary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@motorista.Id" class="btn btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@motorista.Id" class="btn btn-outline-danger">Excluir</a>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"driver"' /></span>
            <h2 class="ev-empty__title">Nenhum motorista cadastrado</h2>
            <p class="ev-empty__text">Cadastre os motoristas que fazem parte da operação para vinculá-los às viagens.</p>
            <a asp-action="Create" class="btn btn-primary">Cadastrar motorista</a>
        </div>
    }
</section>
