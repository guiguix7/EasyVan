@model EasyVan.Models.ParadaFormViewModel
@{ ViewData["Title"] = "Editar parada"; }
<section class="ev-page">
    <a asp-action="Index" class="ev-back"><partial name="_Icon" model='"back"' /> Voltar para paradas</a>
    <header class="ev-page-head"><div class="ev-page-head__text"><p class="ev-eyebrow">Parada #@Model.Id</p><h1>Editar parada</h1></div></header>
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ev-form-layout"><partial name="_Form" model="Model" /></form>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
