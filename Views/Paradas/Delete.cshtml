@model EasyVan.Models.Parada
@{ ViewData["Title"] = "Excluir parada"; }
<section class="ev-page">
    <a asp-action="Index" class="ev-back"><partial name="_Icon" model='"back"' /> Voltar para paradas</a>
    <header class="ev-page-head"><div class="ev-page-head__text"><p class="ev-eyebrow">Confirmação</p><h1>Excluir parada?</h1><p class="ev-page-head__lead">Se houver vínculos atuais ou históricos, a exclusão será bloqueada.</p></div></header>
    <section class="ev-panel"><dl class="ev-detail-grid"><div><dt>Rota</dt><dd>@Model.Rota?.Nome</dd></div><div><dt>Sentido</dt><dd>@(Model.Sentido == EasyVan.Models.SentidoViagem.Ida ? "Ida" : "Volta")</dd></div><div><dt>Ordem</dt><dd>@Model.Ordem</dd></div><div><dt>Endereço</dt><dd>@Model.Endereco</dd></div></dl></section>
    <form asp-action="Delete" method="post" class="ev-form-actions"><input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-danger">Excluir parada</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form>
</section>
