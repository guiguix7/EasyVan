@model EasyVan.Models.ParadaFormViewModel

<div class="ev-form-main">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="ev-notice ev-notice--danger" role="alert"></div>
    <section class="ev-panel ev-form-section">
        <div class="ev-form-grid">
            <div class="ev-field"><label asp-for="RotaId" class="form-label"></label><select asp-for="RotaId" asp-items="Model.Rotas" class="form-select"><option value="0">Selecione uma rota</option></select><span asp-validation-for="RotaId" class="ev-form-validation"></span></div>
            <div class="ev-field"><label asp-for="Sentido" class="form-label"></label><select asp-for="Sentido" asp-items="Model.Sentidos" class="form-select"></select><span asp-validation-for="Sentido" class="ev-form-validation"></span></div>
            <div class="ev-field"><label asp-for="Ordem" class="form-label"></label><input asp-for="Ordem" class="form-control" min="1" /><span asp-validation-for="Ordem" class="ev-form-validation"></span></div>
            <div class="ev-field"><label asp-for="HorarioPrevisto" class="form-label"></label><input asp-for="HorarioPrevisto" type="time" class="form-control" /><span asp-validation-for="HorarioPrevisto" class="ev-form-validation"></span></div>
            <div class="ev-field ev-field--full"><label asp-for="Nome" class="form-label"></label><input asp-for="Nome" class="form-control" maxlength="120" /><span asp-validation-for="Nome" class="ev-form-validation"></span></div>
            <div class="ev-field ev-field--full"><label asp-for="Endereco" class="form-label"></label><input asp-for="Endereco" class="form-control" maxlength="200" /><span asp-validation-for="Endereco" class="ev-form-validation"></span></div>
        </div>
        <div class="ev-check mt-3"><input asp-for="Ativo" class="form-check-input" /><div class="ev-check__text"><label asp-for="Ativo">Parada ativa</label><span>Desative a parada depois de transferir os alunos com vínculo ativo.</span></div></div>
    </section>
    <div class="ev-form-actions"><button type="submit" class="btn btn-primary">Salvar parada</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</div>
