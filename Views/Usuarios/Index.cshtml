@model IEnumerable<EasyVan.Models.Usuarios>

@{
    ViewData["Title"] = "Usuários";
}

<section class="ev-page">
    <header class="ev-page-heading">
        <div>
            <h1>Usuários</h1>
            <p>Consulte as contas e os perfis registrados na plataforma.</p>
        </div>
        <div class="ev-page-actions">
            <a asp-controller="Home" asp-action="Pages" asp-route-id="cadastro" class="btn btn-primary">Novo usuário</a>
        </div>
    </header>

    @if (Model.Any())
    {
        <section class="ev-panel d-none d-lg-block p-0 overflow-hidden" aria-label="Tabela de usuários">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">ID</th><th scope="col">Nome</th><th scope="col">E-mail</th>
                            <th scope="col">Perfil</th><th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model)
                        {
                            <tr>
                                <td>@usuario.Id</td>
                                <td><strong>@usuario.Nome</strong></td>
                                <td>@usuario.Email</td>
                                <td><span class="badge bg-light text-petroleo border">@usuario.RoleManager</span></td>
                                <td class="text-end tabela-acoes">
                                    <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                                    <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-secondary">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
        <section class="ev-mobile-vans d-lg-none" aria-label="Lista de usuários">
            @foreach (var usuario in Model)
            {
                <article class="ev-van-mobile">
                    <div class="ev-van-mobile__head">
                        <div>
                            <div class="ev-van-mobile__plate">@usuario.Nome</div>
                            <div class="ev-van-mobile__id">Usuário #@usuario.Id</div>
                        </div>
                        <span class="badge bg-light text-petroleo border">@usuario.RoleManager</span>
                    </div>
                    <div class="ev-van-mobile__data">
                        <div class="ev-van-mobile__item"><span>E-mail</span><strong>@usuario.Email</strong></div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-outline-primary flex-fill">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-outline-secondary flex-fill">Editar</a>
                        <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-outline-danger flex-fill">Excluir</a>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <h2 class="h5 mb-2">Nenhum usuário cadastrado</h2>
            <p class="mb-3">Cadastre um usuário para disponibilizar acesso à plataforma.</p>
            <a asp-controller="Home" asp-action="Pages" asp-route-id="cadastro" class="btn btn-primary">Cadastrar usuário</a>
        </div>
    }
</section>
