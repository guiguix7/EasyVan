@model IEnumerable<EasyVan.Models.Usuarios>

@{
    ViewData["Title"] = "Usuários";
    var usuarios = Model.ToList();
    var administradores = usuarios.Count(u => u.RoleManager == "Administrador");
    var motoristas = usuarios.Count(u => u.RoleManager == "Motorista");
    var alunos = usuarios.Count(u => u.RoleManager == "Aluno");
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Administração</p>
            <h1>Usuários</h1>
            <p class="ev-page-head__lead">Gerencie as contas e os perfis de acesso à plataforma.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-action="Create" class="btn btn-primary">
                <partial name="_Icon" model='"plus"' />
                Novo usuário
            </a>
        </div>
    </header>

    @if (usuarios.Any())
    {
        <div class="ev-results">
            <p class="mb-0">
                <strong>@usuarios.Count</strong> contas · <strong>@administradores</strong> administradores ·
                <strong>@motoristas</strong> motoristas · <strong>@alunos</strong> alunos.
            </p>
        </div>

        <section class="ev-panel ev-panel--flush ev-list-desktop" aria-label="Tabela de usuários">
            <div class="ev-table-scroll">
                <table class="ev-table">
                    <thead>
                        <tr>
                            <th scope="col">Usuário</th>
                            <th scope="col">E-mail</th>
                            <th scope="col">Perfil</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in usuarios)
                        {
                            <tr>
                                <td>
                                    <span class="ev-table__primary">@usuario.Nome</span>
                                    <span class="ev-table__secondary">Usuário #@usuario.Id</span>
                                </td>
                                <td>@usuario.Email</td>
                                <td><partial name="_StatusBadge" model="usuario.RoleManager" /></td>
                                <td class="is-actions">
                                    <div class="ev-row-actions">
                                        <a asp-action="Details" asp-route-id="@usuario.Id" class="ev-link-action">Detalhes</a>
                                        <a asp-action="Edit" asp-route-id="@usuario.Id" class="ev-link-action">
                                            <partial name="_Icon" model='"edit"' />
                                            Editar
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@usuario.Id" class="ev-link-action ev-link-action--danger">
                                            <partial name="_Icon" model='"trash"' />
                                            Excluir
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-records ev-list-mobile" aria-label="Lista de usuários">
            @foreach (var usuario in usuarios)
            {
                <article class="ev-record">
                    <div class="ev-record__head">
                        <div>
                            <h2 class="ev-record__title">@usuario.Nome</h2>
                            <span class="ev-record__meta">Usuário #@usuario.Id</span>
                        </div>
                        <partial name="_StatusBadge" model="usuario.RoleManager" />
                    </div>
                    <dl class="ev-record__data">
                        <div class="ev-span-2">
                            <dt>E-mail</dt>
                            <dd>@usuario.Email</dd>
                        </div>
                    </dl>
                    <div class="ev-record__actions">
                        <a asp-action="Details" asp-route-id="@usuario.Id" class="btn btn-outline-primary">Detalhes</a>
                        <a asp-action="Edit" asp-route-id="@usuario.Id" class="btn btn-outline-secondary">Editar</a>
                        <a asp-action="Delete" asp-route-id="@usuario.Id" class="btn btn-outline-danger">Excluir</a>
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"users"' /></span>
            <h2 class="ev-empty__title">Nenhum usuário cadastrado</h2>
            <p class="ev-empty__text">Cadastre um usuário para disponibilizar acesso à plataforma.</p>
            <a asp-action="Create" class="btn btn-primary">Cadastrar usuário</a>
        </div>
    }
</section>
