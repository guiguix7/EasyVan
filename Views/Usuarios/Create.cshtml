@model EasyVan.Models.UsuarioCreateViewModel

@{
    ViewData["Title"] = "Novo usuário";
    ViewData["SubmitLabel"] = "Criar usuário";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para usuários
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Administração</p>
            <h1>Novo usuário</h1>
            <p class="ev-page-head__lead">Crie a conta e o perfil operacional juntos. Ao escolher Aluno ou Motorista, o cadastro correspondente é criado ou vinculado pelo e-mail.</p>
        </div>
    </header>

    <div class="ev-form-layout">
        <div class="ev-form-main">
            <section class="ev-panel ev-form-section" aria-labelledby="dados-conta">
                <div class="ev-form-section__head">
                    <h2 id="dados-conta">Dados da conta</h2>
                    <p>Nome, e-mail, perfil e senha inicial.</p>
                </div>
                <partial name="_FormCadastro" model="Model" />
            </section>
        </div>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Perfis de acesso</h2>
                    <ul>
                        <li><strong>Aluno:</strong> consulta as informações de transporte e confirma presença.</li>
                        <li><strong>Motorista:</strong> acompanha e opera as próprias viagens. Exige CNH válida.</li>
                        <li><strong>Administrador:</strong> gerencia cadastros, contas e operação.</li>
                    </ul>
                    <p class="ev-hint mb-0">A mesma pessoa não deve ser cadastrada novamente na área de Alunos ou Motoristas: o vínculo é feito pelo e-mail.</p>
                </div>
            </section>
        </aside>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
