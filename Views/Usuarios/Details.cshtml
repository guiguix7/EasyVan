@model EasyVan.Models.Usuarios

@{
    ViewData["Title"] = "Detalhes do usuário";
    var descricaoPerfil = Model.RoleManager switch
    {
        "Administrador" => "Gerencia cadastros, contas e a operação da frota.",
        "Motorista" => "Acompanha e opera as viagens atribuídas ao seu usuário.",
        _ => "Consulta as informações de transporte disponíveis na plataforma."
    };
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para usuários
    </a>

    <header class="ev-detail-head">
        <div>
            <p class="ev-eyebrow">Administração · Usuário #@Model.Id</p>
            <div class="ev-detail-head__identity">
                <h1>@Model.Nome</h1>
                <partial name="_StatusBadge" model="Model.RoleManager" />
            </div>
            <p class="ev-detail-head__meta">
                <partial name="_Icon" model='"mail"' />
                @Model.Email
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div class="ev-detail-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <partial name="_Icon" model='"edit"' />
                    Editar
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir
                </a>
            </div>
        }
    </header>

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="dados-usuario">
            <div class="ev-panel__head">
                <div>
                    <h2 id="dados-usuario">Dados da conta</h2>
                    <p class="ev-panel__hint">Identificação e perfil de acesso.</p>
                </div>
            </div>
            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>Nome</dt>
                    <dd>@Model.Nome</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Perfil</dt>
                    <dd>@Model.RoleManager</dd>
                </div>
                <div class="ev-data__item">
                    <dt>E-mail</dt>
                    <dd>@Model.Email</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Identificador</dt>
                    <dd class="is-mono">#@Model.Id</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Senha</dt>
                    <dd class="is-muted">Armazenada com hash. A senha original não é exibida.</dd>
                </div>
            </dl>
        </section>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Acesso</h2>
                    <partial name="_StatusBadge" model="Model.RoleManager" />
                    <p class="mt-3 mb-0">@descricaoPerfil</p>
                </div>
            </section>

            <div class="ev-notice ev-notice--info mt-3" role="note">
                <partial name="_Icon" model='"shield"' />
                <div class="ev-notice__body">
                    <p class="ev-notice__title">Conta pessoal</p>
                    <p class="mb-0">Cada pessoa deve usar a própria conta. Não compartilhe credenciais de acesso.</p>
                </div>
            </div>
        </aside>
    </div>
</section>
