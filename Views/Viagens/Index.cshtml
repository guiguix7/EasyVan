@model IEnumerable<EasyVan.Models.Viagem>
@using EasyVan.Models

@{
    ViewData["Title"] = "Viagens";
    var papel = ViewData["Papel"] as string ?? string.Empty;
}

<section class="ev-page">
    <header class="ev-page-heading">
        <div>
            <h1>Viagens</h1>
            <p>Consulte as viagens registradas e acompanhe seus horários e situação.</p>
        </div>
        <div class="ev-page-actions">
            <a asp-action="Create" class="btn btn-primary">Nova viagem</a>
        </div>
    </header>

    @if (Model.Any())
    {
        <section class="ev-panel d-none d-lg-block p-0 overflow-hidden" aria-label="Tabela de viagens">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col">Viagem</th>
                            <th scope="col">Data</th>
                            <th scope="col">Van</th>
                            <th scope="col">Motorista</th>
                            <th scope="col">Rota</th>
                            <th scope="col">Horários</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var viagem in Model)
                        {
                            var statusClass = viagem.Status == "Finalizada"
                                ? "badge-status-operacional"
                                : viagem.Status == "EmAndamento" ? "badge bg-info text-dark" : "badge bg-secondary";
                            <tr>
                                <td><strong>#@viagem.Id</strong></td>
                                <td>@viagem.Data.ToShortDateString()</td>
                                <td>@viagem.Van?.Plate</td>
                                <td>@viagem.Motorista?.Nome</td>
                                <td>@viagem.Rota?.Nome</td>
                                <td>
                                    @(viagem.HoraInicio.HasValue ? viagem.HoraInicio.Value.ToString(@"hh\:mm") : "—")
                                    /
                                    @(viagem.HoraFim.HasValue ? viagem.HoraFim.Value.ToString(@"hh\:mm") : "—")
                                </td>
                                <td><span class="badge @statusClass">@viagem.Status</span></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@viagem.Id" class="btn btn-sm btn-outline-primary">Detalhes</a>
                                    @if (papel == "Motorista" || User.IsInRole("Administrador"))
                                    {
                                        if (viagem.Status == "Agendada")
                                        {
                                            <form asp-action="Start" asp-route-id="@viagem.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-success">Iniciar</button>
                                            </form>
                                        }
                                        else if (viagem.Status == "EmAndamento")
                                        {
                                            <form asp-action="Finish" asp-route-id="@viagem.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger">Finalizar</button>
                                            </form>
                                            <a asp-action="Details" asp-route-id="@viagem.Id" class="btn btn-sm btn-outline-secondary">Presença</a>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-mobile-vans d-lg-none" aria-label="Lista de viagens">
            @foreach (var viagem in Model)
            {
                var statusClass = viagem.Status == "Finalizada"
                    ? "badge-status-operacional"
                    : viagem.Status == "EmAndamento" ? "badge bg-info text-dark" : "badge bg-secondary";
                <article class="ev-van-mobile">
                    <div class="ev-van-mobile__head">
                        <div>
                            <div class="ev-van-mobile__plate">Viagem #@viagem.Id</div>
                            <div class="ev-van-mobile__id">@viagem.Data.ToShortDateString()</div>
                        </div>
                        <span class="badge @statusClass">@viagem.Status</span>
                    </div>
                    <div class="ev-van-mobile__data">
                        <div class="ev-van-mobile__item">
                            <span>Van</span>
                            <strong>@viagem.Van?.Plate</strong>
                        </div>
                        <div class="ev-van-mobile__item">
                            <span>Motorista</span>
                            <strong>@viagem.Motorista?.Nome</strong>
                        </div>
                        <div class="ev-van-mobile__item">
                            <span>Rota</span>
                            <strong>@viagem.Rota?.Nome</strong>
                        </div>
                        <div class="ev-van-mobile__item">
                            <span>Horários</span>
                            <strong>
                                @(viagem.HoraInicio.HasValue ? viagem.HoraInicio.Value.ToString(@"hh\:mm") : "—")
                                /
                                @(viagem.HoraFim.HasValue ? viagem.HoraFim.Value.ToString(@"hh\:mm") : "—")
                            </strong>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-action="Details" asp-route-id="@viagem.Id" class="btn btn-outline-primary flex-fill">Detalhes</a>
                        @if (papel == "Motorista" || User.IsInRole("Administrador"))
                        {
                            if (viagem.Status == "Agendada")
                            {
                                <form asp-action="Start" asp-route-id="@viagem.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-success w-100">Iniciar</button>
                                </form>
                            }
                            else if (viagem.Status == "EmAndamento")
                            {
                                <form asp-action="Finish" asp-route-id="@viagem.Id" method="post" class="flex-fill">
                                    <button type="submit" class="btn btn-danger w-100">Finalizar</button>
                                </form>
                            }
                        }
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <h2 class="h5 mb-2">Nenhuma viagem cadastrada</h2>
            <p class="mb-3">Quando uma viagem for registrada, ela aparecerá nesta lista.</p>
            <a asp-action="Create" class="btn btn-primary">Cadastrar primeira viagem</a>
        </div>
    }
</section>
