@model IEnumerable<EasyVan.Models.Viagem>
@using EasyVan.Models
@using EasyVan.Services

@{
    ViewData["Title"] = "Viagens";
    var papel = ViewData["Papel"] as string ?? string.Empty;
    var ehMotorista = papel == "Motorista";
    var viagens = Model.ToList();
    var agendadas = viagens.Count(v => v.Status == "Agendada");
    var emAndamento = viagens.Count(v => v.Status == "EmAndamento");
    var finalizadas = viagens.Count(v => v.Status == "Finalizada");
    var calendario = ViewData["Calendario"] as CalendarioViagensViewModel;
    var hoje = ViagemAgenda.AgoraLocal().Date;

    string Hora(TimeSpan? valor) => valor.HasValue ? valor.Value.ToString(@"hh\:mm") : "—";
    string HoraReal(DateTime? valor) => valor.HasValue ? ViagemAgenda.ParaLocal(valor.Value).ToString("HH:mm") : "—";
    string ClasseViagem(string? status) => status switch
    {
        "Agendada" => "ev-calendar__trip--info",
        "EmAndamento" => "ev-calendar__trip--warning",
        "Finalizada" => "ev-calendar__trip--success",
        _ => ""
    };
    (string Ano, string Mes) SepararMes(string valor)
    {
        var partes = valor.Split('-');
        return partes.Length == 2 ? (partes[0], partes[1]) : (DateTime.Today.Year.ToString(), DateTime.Today.Month.ToString());
    }
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Operação</p>
            <h1>Viagens</h1>
            <p class="ev-page-head__lead">
                @if (ehMotorista)
                {
                    <text>Acompanhe as viagens atribuídas a você e registre início, fim e presença.</text>
                }
                else
                {
                    <text>Acompanhe a operação do dia: horários, vans, motoristas e situação de cada viagem.</text>
                }
            </p>
        </div>
        <div class="ev-page-head__actions">
            @if (!ehMotorista)
            {
                <a asp-controller="Linhas" asp-action="Create" class="btn btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Nova linha
                </a>
            }
        </div>
    </header>

    @if (calendario != null)
    {
        var mesAnterior = SepararMes(calendario.MesAnterior);
        var mesSeguinte = SepararMes(calendario.MesSeguinte);

        <section class="ev-panel ev-calendar" aria-labelledby="calendario-viagens">
            <div class="ev-calendar__head">
                <div>
                    <h2 id="calendario-viagens">Calendário</h2>
                    <p class="ev-panel__hint">Viagens agrupadas por dia, no fuso de São Paulo.</p>
                </div>
                <nav class="ev-calendar__nav" aria-label="Navegação do calendário">
                    <a asp-action="Index" asp-route-ano="@mesAnterior.Ano" asp-route-mes="@mesAnterior.Mes"
                       class="btn btn-outline-secondary btn-sm" aria-label="Mês anterior">Anterior</a>
                    <strong class="ev-calendar__month">@calendario.NomeMes</strong>
                    <a asp-action="Index" asp-route-ano="@mesSeguinte.Ano" asp-route-mes="@mesSeguinte.Mes"
                       class="btn btn-outline-secondary btn-sm" aria-label="Próximo mês">Próximo</a>
                </nav>
            </div>

            <div class="ev-calendar__weekdays" aria-hidden="true">
                <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
            </div>
            <div class="ev-calendar__grid" role="grid" aria-label="Viagens de @calendario.NomeMes">
                @foreach (var dia in calendario.Dias)
                {
                    <div class="ev-calendar__day @(dia.DoMes ? "" : "is-outside") @(dia.Data.Date == hoje ? "is-today" : "")"
                         role="gridcell" aria-label="@dia.Data.ToString("dd/MM/yyyy")">
                        <span class="ev-calendar__day-number">@dia.Data.Day</span>
                        @foreach (var viagem in dia.Viagens.Take(2))
                        {
                            <a asp-action="Details" asp-route-id="@viagem.Id"
                               class="ev-calendar__trip @ClasseViagem(viagem.Status)"
                               title="@(viagem.Rota?.Nome ?? "Viagem") · @Hora(viagem.HoraInicio) · @viagem.Data.ToString("dd/MM/yyyy")">
                                @Hora(viagem.HoraInicio) @(viagem.Rota?.Nome ?? "Viagem")
                            </a>
                        }
                        @if (dia.Viagens.Count > 2)
                        {
                            <span class="ev-calendar__more">+@(dia.Viagens.Count - 2) viagens</span>
                        }
                    </div>
                }
            </div>

            <div class="ev-calendar__agenda ev-list-mobile">
                @{
                    var diasComViagens = calendario.Dias.Where(d => d.DoMes && d.Viagens.Any()).ToList();
                }
                @if (diasComViagens.Any())
                {
                    foreach (var dia in diasComViagens)
                    {
                        <div class="ev-calendar__agenda-day">
                            <h3>@dia.Data.ToString("dd/MM/yyyy")</h3>
                            @foreach (var viagem in dia.Viagens)
                            {
                                <a asp-action="Details" asp-route-id="@viagem.Id" class="ev-calendar__agenda-item">
                                    <span class="is-mono">@Hora(viagem.HoraInicio)</span>
                                    <span>@(viagem.Rota?.Nome ?? "Rota removida")</span>
                                    <partial name="_StatusBadge" model="viagem.Status" />
                                </a>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="ev-hint mb-0">Nenhuma viagem neste mês.</p>
                }
            </div>
        </section>
    }

    @if (viagens.Any())
    {
        <div class="ev-metrics">
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Total</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"trip"' /></span>
                </div>
                <span class="ev-metric__value">@viagens.Count</span>
                <span class="ev-metric__hint">viagens registradas</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Agendadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"calendar"' /></span>
                </div>
                <span class="ev-metric__value">@agendadas</span>
                <span class="ev-metric__hint">aguardando início</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Em andamento</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
                </div>
                <span class="ev-metric__value">@emAndamento</span>
                <span class="ev-metric__hint">na estrada agora</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Finalizadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"check"' /></span>
                </div>
                <span class="ev-metric__value">@finalizadas</span>
                <span class="ev-metric__hint">concluídas</span>
            </article>
        </div>

        <section class="ev-panel ev-panel--flush ev-list-desktop" aria-label="Tabela de viagens">
            <div class="ev-table-scroll">
                <table class="ev-table">
                    <thead>
                        <tr>
                            <th scope="col">Viagem</th>
                            <th scope="col">Data</th>
                            <th scope="col">Rota</th>
                            <th scope="col">Van</th>
                            <th scope="col">Motorista</th>
                            <th scope="col">Horário</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var indice = 0; indice < viagens.Count; indice++)
                        {
                            var viagem = viagens[indice];
                            var numero = indice + 1;
                            <tr>
                                <td><span class="ev-table__primary">Viagem @numero</span></td>
                                <td>@viagem.Data.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="ev-table__primary">@(viagem.Rota?.Nome ?? "Rota removida")</span>
                                    @if (viagem.Rota != null)
                                    {
                                        <span class="ev-table__secondary">@viagem.Rota.Origem → @viagem.Rota.Destino</span>
                                    }
                                </td>
                                <td><span class="ev-plate">@(viagem.Van?.Plate ?? "—")</span></td>
                                <td>@(viagem.Motorista?.Nome ?? "—")</td>
                                <td class="text-nowrap">
                                    <span class="ev-table__primary">@Hora(viagem.HoraInicio) – @Hora(viagem.HoraFim)</span>
                                    @if (viagem.InicioReal.HasValue || viagem.FimReal.HasValue)
                                    {
                                        <span class="ev-table__secondary">Real: @HoraReal(viagem.InicioReal) – @HoraReal(viagem.FimReal)</span>
                                    }
                                </td>
                                <td><partial name="_StatusBadge" model="viagem.Status" /></td>
                                <td class="is-actions">
                                    <div class="ev-row-actions">
                                        <a asp-action="Details" asp-route-id="@viagem.Id" class="ev-link-action">Detalhes</a>
                                        @if (viagem.Status == "Agendada" || viagem.Status == "Confirmada")
                                        {
                                            <a asp-action="Edit" asp-route-id="@viagem.Id" class="ev-link-action">Editar</a>
                                        }
                                        @if (viagem.Status == "Agendada")
                                        {
                                            <form asp-action="Start" asp-route-id="@viagem.Id" method="post" class="ev-inline-form">
                                                <button type="submit" class="ev-link-action">Iniciar</button>
                                            </form>
                                        }
                                        else if (viagem.Status == "EmAndamento")
                                        {
                                            <form asp-action="Finish" asp-route-id="@viagem.Id" method="post" class="ev-inline-form">
                                                <button type="submit" class="ev-link-action ev-link-action--danger">Finalizar</button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-records ev-list-mobile" aria-label="Lista de viagens">
            @for (var indice = 0; indice < viagens.Count; indice++)
            {
                var viagem = viagens[indice];
                var numero = indice + 1;
                <article class="ev-record">
                    <div class="ev-record__head">
                        <div>
                            <h2 class="ev-record__title">Viagem @numero</h2>
                            <span class="ev-record__meta">@viagem.Data.ToString("dd/MM/yyyy") · @Hora(viagem.HoraInicio) – @Hora(viagem.HoraFim)</span>
                        </div>
                        <partial name="_StatusBadge" model="viagem.Status" />
                    </div>

                    @if (viagem.Rota != null)
                    {
                        <div class="ev-route-leg" aria-label="Trajeto">
                            <span class="ev-route-leg__stop">@viagem.Rota.Origem</span>
                            <partial name="_Icon" model='"arrow-right"' />
                            <span class="ev-route-leg__stop ev-route-leg__stop--end">@viagem.Rota.Destino</span>
                        </div>
                    }

                    <dl class="ev-record__data">
                        <div>
                            <dt>Rota</dt>
                            <dd>@(viagem.Rota?.Nome ?? "Rota removida")</dd>
                        </div>
                        <div>
                            <dt>Van</dt>
                            <dd class="is-mono">@(viagem.Van?.Plate ?? "—")</dd>
                        </div>
                        <div>
                            <dt>Motorista</dt>
                            <dd>@(viagem.Motorista?.Nome ?? "—")</dd>
                        </div>
                        <div>
                            <dt>Horários</dt>
                            <dd>
                                Previsto: @Hora(viagem.HoraInicio) – @Hora(viagem.HoraFim)
                                @if (viagem.InicioReal.HasValue || viagem.FimReal.HasValue)
                                {
                                    <br />
                                    <span class="text-muted">Real: @HoraReal(viagem.InicioReal) – @HoraReal(viagem.FimReal)</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <div class="ev-record__actions">
                        <a asp-action="Details" asp-route-id="@viagem.Id" class="btn btn-outline-primary">Detalhes</a>
                        @if (viagem.Status == "Agendada" || viagem.Status == "Confirmada")
                        {
                            <a asp-action="Edit" asp-route-id="@viagem.Id" class="btn btn-outline-secondary">Editar</a>
                        }
                        @if (viagem.Status == "Agendada")
                        {
                            <form asp-action="Start" asp-route-id="@viagem.Id" method="post" class="ev-inline-form">
                                <button type="submit" class="btn btn-primary">Iniciar</button>
                            </form>
                        }
                        else if (viagem.Status == "EmAndamento")
                        {
                            <form asp-action="Finish" asp-route-id="@viagem.Id" method="post" class="ev-inline-form">
                                <button type="submit" class="btn btn-danger">Finalizar</button>
                            </form>
                        }
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"trip"' /></span>
            <h2 class="ev-empty__title">Nenhuma viagem registrada</h2>
            <p class="ev-empty__text">
                @if (ehMotorista)
                {
                    <text>Quando uma viagem for atribuída a você, ela aparecerá aqui.</text>
                }
                else
                {
                    <text>Agende a primeira viagem para começar a acompanhar a operação.</text>
                }
            </p>
            <a asp-action="Create" class="btn btn-primary">Cadastrar primeira viagem</a>
        </div>
    }
</section>
