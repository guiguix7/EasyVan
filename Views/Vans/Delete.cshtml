@model EasyVan.Models.Van
@using EasyVan.Services

@{
    ViewData["Title"] = "Excluir van";
    var modelo = string.IsNullOrWhiteSpace(Model.Modelo) ? "Modelo não informado" : Model.Modelo;
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para vans
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Confirmação</p>
            <h1>Excluir van</h1>
            <p class="ev-page-head__lead">Revise o veículo antes de confirmar. A exclusão não pode ser desfeita.</p>
        </div>
    </header>

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="van-exclusao">
            <div class="ev-panel__head">
                <div>
                    <h2 id="van-exclusao"><span class="ev-plate">@Model.Plate</span></h2>
                    <p class="ev-panel__hint">@modelo</p>
                </div>
                <partial name="_StatusBadge" model="Model.Status" />
            </div>
            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>Motorista</dt>
                    <dd>@VanUi.Motorista(Model)</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Capacidade</dt>
                    <dd>@Model.Capacity lugares</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Rota</dt>
                    <dd>@VanUi.Rota(Model)</dd>
                </div>
            </dl>
        </section>

        <aside>
            <div class="ev-notice ev-notice--danger" role="alert">
                <partial name="_Icon" model='"alert"' />
                <div class="ev-notice__body">
                    <p class="ev-notice__title">Esta ação é permanente</p>
                    <p class="mb-0">A van será removida da frota. Se ela estiver associada a viagens, o histórico pode ser afetado.</p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="ev-form-actions mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir definitivamente
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </aside>
    </div>
</section>
