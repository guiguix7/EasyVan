@model EasyVan.Models.VanFormViewModel

@{
    ViewData["Title"] = "Editar van";
    var statusAtual = string.IsNullOrWhiteSpace(Model.Status) ? "Operacional" : Model.Status.Trim();
    var statusConhecido = statusAtual == "Operacional" || statusAtual == "Manutenção";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para vans
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Van #@Model.Id</p>
            <h1>Editar van</h1>
            <p class="ev-page-head__lead">Atualize o veículo, os vínculos e a situação exibida na operação.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Ver detalhes</a>
        </div>
    </header>

    <form asp-action="Edit" method="post" class="ev-form-layout">
        <div class="ev-form-main">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="ev-notice ev-notice--danger" role="alert"></div>

            <section class="ev-panel ev-form-section" aria-labelledby="identificacao-van">
                <div class="ev-form-section__head">
                    <h2 id="identificacao-van">Identificação</h2>
                    <p>Placa, capacidade e situação do veículo.</p>
                </div>
                <div class="ev-form-grid">
                    <div class="ev-field">
                        <label asp-for="Plate" class="form-label">Placa <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Plate" class="form-control" autocapitalize="characters" spellcheck="false" autocomplete="off" />
                        <span asp-validation-for="Plate" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="Capacity" class="form-label">Capacidade (lugares) <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Capacity" class="form-control" type="number" min="1" max="1000" step="1" inputmode="numeric" />
                        <span asp-validation-for="Capacity" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field ev-span-2">
                        <label asp-for="Status" class="form-label">Status <span class="ev-required" aria-hidden="true">*</span></label>
                        <select asp-for="Status" class="form-select">
                            @if (!statusConhecido)
                            {
                                <option value="@statusAtual" selected>@statusAtual</option>
                            }
                            <option value="Operacional" selected="@(statusAtual == "Operacional")">Operacional</option>
                            <option value="Manutenção" selected="@(statusAtual == "Manutenção")">Manutenção</option>
                        </select>
                        <p class="ev-hint">Veículos em manutenção aparecem como atenção no painel.</p>
                        <span asp-validation-for="Status" class="ev-form-validation"></span>
                    </div>
                </div>
            </section>

            <section class="ev-panel ev-form-section" aria-labelledby="operacao-van">
                <div class="ev-form-section__head">
                    <h2 id="operacao-van">Operação</h2>
                    <p>Vínculos reais usados nas viagens e na listagem.</p>
                </div>
                <div class="ev-form-grid">
                    <div class="ev-field">
                        <label asp-for="MotoristaId" class="form-label">Motorista <span class="ev-required" aria-hidden="true">*</span></label>
                        <select asp-for="MotoristaId" asp-items="Model.Motoristas" class="form-select">
                            <option value="">Selecione o motorista</option>
                        </select>
                        <span asp-validation-for="MotoristaId" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="RotaId" class="form-label">Rota <span class="ev-required" aria-hidden="true">*</span></label>
                        <select asp-for="RotaId" asp-items="Model.Rotas" class="form-select">
                            <option value="">Selecione a rota</option>
                        </select>
                        <span asp-validation-for="RotaId" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field ev-span-2">
                        <span class="form-label" id="rotulo-horarios">Horários <span class="ev-required" aria-hidden="true">*</span></span>
                        <div class="ev-schedule" data-horarios aria-labelledby="rotulo-horarios">
                            @for (var i = 0; i < Model.Horarios.Count; i++)
                            {
                                <div class="ev-schedule__row">
                                    <input type="time" class="form-control" name="Horarios" value="@Model.Horarios[i]" aria-label="Horário @(i + 1)" />
                                    <button type="button" class="btn btn-outline-secondary" data-horario-remove aria-label="Remover horário @(i + 1)">
                                        <partial name="_Icon" model='"trash"' />
                                    </button>
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-outline-secondary ev-schedule__add" data-horario-add>
                            <partial name="_Icon" model='"plus"' />
                            Adicionar horário
                        </button>
                        <p class="ev-hint">Informe de 1 a 10 horários. O mesmo horário não pode ser repetido.</p>
                        <span asp-validation-for="Horarios" class="ev-form-validation"></span>
                    </div>
                </div>
            </section>

            <section class="ev-panel ev-form-section" aria-labelledby="observacoes-van">
                <div class="ev-form-section__head">
                    <h2 id="observacoes-van">Observações</h2>
                    <p>Campo opcional, útil para quem consulta a frota.</p>
                </div>
                <div class="ev-field">
                    <label asp-for="Description" class="form-label">Descrição</label>
                    <textarea asp-for="Description" class="form-control" rows="4" maxlength="500"></textarea>
                    <span asp-validation-for="Description" class="ev-form-validation"></span>
                </div>
            </section>

            <div class="ev-form-actions">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                <span class="ev-form-actions__spacer"></span>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir van
                </a>
            </div>
        </div>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Efeito das alterações</h2>
                    <ul>
                        <li>A listagem e os filtros usam os dados salvos aqui.</li>
                        <li>Viagens já registradas mantêm o histórico do veículo.</li>
                        <li>A descrição pode permanecer vazia.</li>
                        <li>O status <strong>Manutenção</strong> sinaliza o veículo para atenção no painel.</li>
                    </ul>
                </div>
            </section>
        </aside>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
