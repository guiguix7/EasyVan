@model EasyVan.Models.Van

@{
    ViewData["Title"] = "Nova Van";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3">Nova Van</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à listagem</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Plate" class="form-label">Placa</label>
                            <input asp-for="Plate" class="form-control" placeholder="Ex: ABC-1234" />
                            <span asp-validation-for="Plate" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Driver" class="form-label">Motorista</label>
                            <input asp-for="Driver" class="form-control" placeholder="Nome do motorista" />
                            <span asp-validation-for="Driver" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Capacity" class="form-label">Capacidade (alunos)</label>
                            <input asp-for="Capacity" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Capacity" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Route" class="form-label">Rota</label>
                            <input asp-for="Route" class="form-control" placeholder="Ex: Centro - Universidade" />
                            <span asp-validation-for="Route" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Schedule" class="form-label">Horários</label>
                            <input asp-for="Schedule" class="form-control" placeholder="Ex: 07:00 / 17:30" />
                            <span asp-validation-for="Schedule" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Status" class="form-label">Status</label>
                            <input asp-for="Status" class="form-control" placeholder="Ex: Operacional" />
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Descrição</label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary">Salvar Van</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
