@model IEnumerable<EasyVan.Models.Van>

@{
    ViewData["Title"] = "Listagem de Vans";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3">Vans</h1>
        <a asp-controller="Vans" asp-action="Index" class="btn btn-secondary">Atualizar</a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Placa</th>
                    <th>Motorista</th>
                    <th>Capacidade</th>
                    <th>Rota</th>
                    <th>Horários</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var van in Model)
                {
                    <tr>
                        <td>@van.Plate</td>
                        <td>@van.Driver</td>
                        <td>@van.Capacity</td>
                        <td>@van.Route</td>
                        <td>@van.Schedule</td>
                        <td>
                            @if (van.Status == "Operacional")
                            {
                                <span class="badge bg-success">@van.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">@van.Status</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="Vans" asp-action="Details" asp-route-id="@van.Id" class="btn btn-sm btn-info">Detalhes</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
