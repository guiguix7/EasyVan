@model EasyVan.Models.VanIndexViewModel

@{
    ViewData["Title"] = "Vans";
    var filtrosAtivos = Model.Filtro.TemFiltroAtivo;
    var estado = ViewData.ModelState;
    var erroBusca = estado.TryGetValue("Busca", out var entradaBusca) && entradaBusca.Errors.Count > 0
        ? entradaBusca.Errors[0].ErrorMessage : null;
    var erroStatus = estado.TryGetValue("Status", out var entradaStatus) && entradaStatus.Errors.Count > 0
        ? entradaStatus.Errors[0].ErrorMessage : null;
    var erroMin = estado.TryGetValue("CapacidadeMin", out var entradaMin) && entradaMin.Errors.Count > 0
        ? entradaMin.Errors[0].ErrorMessage : null;
    var erroMax = estado.TryGetValue("CapacidadeMax", out var entradaMax) && entradaMax.Errors.Count > 0
        ? entradaMax.Errors[0].ErrorMessage : null;
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Cadastros</p>
            <h1>Vans</h1>
            <p class="ev-page-head__lead">Consulte os veículos, refine a busca e verifique a situação da frota.</p>
        </div>
        <div class="ev-page-head__actions">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Cadastrar van
                </a>
            }
        </div>
    </header>

    <section class="ev-filter" aria-label="Busca e filtros de vans">
        <form method="get" asp-controller="Vans" asp-action="Index" role="search">
            <div class="ev-filter__grid">
                <div class="ev-field">
                    <label for="busca" class="form-label">Buscar veículo</label>
                    <input type="search" id="busca" name="busca" value="@Model.Filtro.Busca"
                           maxlength="100" class="form-control" autocomplete="off"
                           placeholder="Placa, motorista, rota ou descrição"
                           aria-invalid="@(erroBusca is null ? null : "true")"
                           aria-describedby="@(erroBusca is null ? null : "busca-erro")" />
                    @if (erroBusca is not null)
                    {
                        <span id="busca-erro" class="ev-form-validation">@erroBusca</span>
                    }
                </div>

                <div class="ev-field">
                    <label for="status" class="form-label">Status</label>
                    <select id="status" name="status" class="form-select"
                            aria-invalid="@(erroStatus is null ? null : "true")"
                            aria-describedby="@(erroStatus is null ? null : "status-erro")">
                        <option value="">Todos</option>
                        @foreach (var status in Model.StatusDisponiveis)
                        {
                            if (string.Equals(status, Model.Filtro.Status?.Trim(), StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@status" selected>@status</option>
                            }
                            else
                            {
                                <option value="@status">@status</option>
                            }
                        }
                    </select>
                    @if (erroStatus is not null)
                    {
                        <span id="status-erro" class="ev-form-validation">@erroStatus</span>
                    }
                </div>

                <div class="ev-field">
                    <label for="capacidadeMin" class="form-label">Mín.</label>
                    <input type="number" id="capacidadeMin" name="capacidadeMin"
                           value="@Model.Filtro.CapacidadeMin" min="0" max="1000" step="1"
                           class="form-control" aria-label="Capacidade mínima, em lugares"
                           aria-invalid="@(erroMin is null ? null : "true")"
                           aria-describedby="@(erroMin is null ? null : "capacidade-min-erro")" />
                    @if (erroMin is not null)
                    {
                        <span id="capacidade-min-erro" class="ev-form-validation">@erroMin</span>
                    }
                </div>

                <div class="ev-field">
                    <label for="capacidadeMax" class="form-label">Máx.</label>
                    <input type="number" id="capacidadeMax" name="capacidadeMax"
                           value="@Model.Filtro.CapacidadeMax" min="0" max="1000" step="1"
                           class="form-control" aria-label="Capacidade máxima, em lugares"
                           aria-invalid="@(erroMax is null ? null : "true")"
                           aria-describedby="@(erroMax is null ? null : "capacidade-max-erro")" />
                    @if (erroMax is not null)
                    {
                        <span id="capacidade-max-erro" class="ev-form-validation">@erroMax</span>
                    }
                </div>

                <div class="ev-filter__actions">
                    <button type="submit" class="btn btn-primary">
                        <partial name="_Icon" model='"filter"' />
                        Aplicar
                    </button>
                    <a asp-controller="Vans" asp-action="Index" class="btn btn-outline-secondary">Limpar</a>
                </div>
            </div>
        </form>

        @if (filtrosAtivos)
        {
            <div class="ev-filter-chips" aria-label="Filtros ativos">
                <span class="ev-filter-chips__label">Filtros ativos:</span>
                @if (!string.IsNullOrWhiteSpace(Model.Filtro.Busca))
                {
                    <span class="ev-filter-chip">Busca: @Model.Filtro.Busca</span>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Filtro.Status))
                {
                    <span class="ev-filter-chip">Status: @Model.Filtro.Status</span>
                }
                @if (Model.Filtro.CapacidadeMin.HasValue)
                {
                    <span class="ev-filter-chip">Mínimo: @Model.Filtro.CapacidadeMin</span>
                }
                @if (Model.Filtro.CapacidadeMax.HasValue)
                {
                    <span class="ev-filter-chip">Máximo: @Model.Filtro.CapacidadeMax</span>
                }
                <a asp-controller="Vans" asp-action="Index" class="ev-link-action">Limpar filtros</a>
            </div>
        }
    </section>

    <div class="ev-results">
        <p class="mb-0">
            Exibindo <strong>@Model.Vans.Count</strong> de <strong>@Model.TotalGeral</strong> vans.
        </p>
        <a href="@Url.Action("Index", "Vans", new { busca = Model.Filtro.Busca, status = Model.Filtro.Status, capacidadeMin = Model.Filtro.CapacidadeMin, capacidadeMax = Model.Filtro.CapacidadeMax })"
           class="ev-results__refresh">
            <partial name="_Icon" model='"refresh"' />
            Atualizar resultados
        </a>
    </div>

    @if (!Model.Vans.Any())
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"search"' /></span>
            <h2 class="ev-empty__title">@(filtrosAtivos ? "Nenhuma van encontrada" : "Sua frota ainda está vazia")</h2>
            <p class="ev-empty__text">
                @(filtrosAtivos
                    ? "Não encontramos veículos com os critérios informados. Ajuste os filtros ou limpe a busca."
                    : "Cadastre uma van para começar a organizar os veículos da operação.")
            </p>
            @if (filtrosAtivos)
            {
                <a asp-controller="Vans" asp-action="Index" class="btn btn-outline-primary">Limpar filtros</a>
            }
            else if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary">Cadastrar primeira van</a>
            }
        </div>
    }
    else
    {
        <section class="ev-panel ev-panel--flush ev-list-desktop" aria-label="Tabela de vans">
            <div class="ev-table-scroll">
                <table class="ev-table">
                    <thead>
                        <tr>
                            <th scope="col">Identificação</th>
                            <th scope="col">Motorista</th>
                            <th scope="col">Capacidade</th>
                            <th scope="col">Rota</th>
                            <th scope="col">Horários</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var van in Model.Vans)
                        {
                            <tr>
                                <td>
                                    <span class="ev-plate">@van.Plate</span>
                                    <span class="ev-table__secondary">Van #@van.Id</span>
                                </td>
                                <td>
                                    <span class="ev-table__primary">@(string.IsNullOrWhiteSpace(van.Driver) ? "Não informado" : van.Driver)</span>
                                </td>
                                <td class="is-numeric">@van.Capacity lugares</td>
                                <td>@van.Route</td>
                                <td class="is-numeric">@van.Schedule</td>
                                <td><partial name="_StatusBadge" model="van.Status" /></td>
                                <td class="is-actions">
                                    <div class="ev-row-actions">
                                        <a asp-controller="Vans" asp-action="Details" asp-route-id="@van.Id" class="ev-link-action">
                                            Detalhes
                                        </a>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-controller="Vans" asp-action="Edit" asp-route-id="@van.Id" class="ev-link-action">
                                                <partial name="_Icon" model='"edit"' />
                                                Editar
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-records ev-list-mobile" aria-label="Lista de vans">
            @foreach (var van in Model.Vans)
            {
                <article class="ev-record">
                    <div class="ev-record__head">
                        <div>
                            <h2 class="ev-record__title"><span class="ev-plate">@van.Plate</span></h2>
                            <span class="ev-record__meta">Van #@van.Id</span>
                        </div>
                        <partial name="_StatusBadge" model="van.Status" />
                    </div>
                    <dl class="ev-record__data">
                        <div>
                            <dt>Motorista</dt>
                            <dd>@(string.IsNullOrWhiteSpace(van.Driver) ? "Não informado" : van.Driver)</dd>
                        </div>
                        <div>
                            <dt>Capacidade</dt>
                            <dd>@van.Capacity lugares</dd>
                        </div>
                        <div>
                            <dt>Rota</dt>
                            <dd>@van.Route</dd>
                        </div>
                        <div>
                            <dt>Horários</dt>
                            <dd>@van.Schedule</dd>
                        </div>
                    </dl>
                    <div class="ev-record__actions">
                        <a asp-controller="Vans" asp-action="Details" asp-route-id="@van.Id" class="btn btn-outline-primary">Detalhes</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-controller="Vans" asp-action="Edit" asp-route-id="@van.Id" class="btn btn-outline-secondary">Editar</a>
                        }
                    </div>
                </article>
            }
        </section>
    }
</section>
