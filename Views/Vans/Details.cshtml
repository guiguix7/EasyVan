@model EasyVan.Models.Van

@{
    ViewData["Title"] = "Detalhes da Van";
}

<section class="py-4">
    <div class="mb-3">
        <a asp-controller="Vans" asp-action="Index" class="btn btn-outline-secondary">&larr; Voltar à listagem</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h2 class="card-title">Van @Model.Plate</h2>
            <h6 class="card-subtitle mb-2 text-muted">Motorista: @Model.Driver</h6>
            <p class="mb-2"><strong>Rota:</strong> @Model.Route</p>
            <p class="mb-2"><strong>Horários:</strong> @Model.Schedule</p>
            <p class="mb-2"><strong>Capacidade:</strong> @Model.Capacity passageiros</p>
            <p class="mb-2"><strong>Status:</strong> @Model.Status</p>
            <p class="mt-3">@Model.Description</p>
        </div>
    </div>
</section>
