@model EasyVan.Models.Van
@using EasyVan.Services

@{
    ViewData["Title"] = "Detalhes da van";
    var descricao = string.IsNullOrWhiteSpace(Model.Description) ? "Sem descrição cadastrada." : Model.Description;
    var motorista = VanUi.Motorista(Model);
    var rota = VanUi.Rota(Model);
    var identificacao = VanUi.Identificacao(Model);
}

<section class="ev-page">
    <a asp-controller="Vans" asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para vans
    </a>

    <header class="ev-detail-head">
        <div>
            <p class="ev-eyebrow">Veículo da frota</p>
            <div class="ev-detail-head__identity">
                <h1><span class="ev-plate ev-plate--lg">@Model.Plate</span></h1>
                <partial name="_StatusBadge" model="Model.Status" />
            </div>
            <p class="ev-detail-head__meta">
                <partial name="_Icon" model='"van"' />
                @identificacao
                <span aria-hidden="true">·</span>
                <partial name="_Icon" model='"driver"' />
                @motorista
                <span aria-hidden="true">·</span>
                <partial name="_Icon" model='"route"' />
                @rota
            </p>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div class="ev-detail-actions">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                    <partial name="_Icon" model='"edit"' />
                    Editar
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir
                </a>
            </div>
        }
    </header>

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="dados-van">
            <div class="ev-panel__head">
                <div>
                    <h2 id="dados-van">Dados do veículo</h2>
                    <p class="ev-panel__hint">Informações usadas na operação e nas viagens.</p>
                </div>
            </div>
            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>Placa</dt>
                    <dd class="is-mono">@Model.Plate</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Modelo</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Modelo) ? "Modelo não informado" : Model.Modelo)</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Capacidade</dt>
                    <dd>@Model.Capacity lugares</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Motorista no cadastro</dt>
                    <dd>@motorista</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Horários</dt>
                    <dd class="is-mono">@(string.IsNullOrWhiteSpace(Model.Schedule) ? "Não informados" : Model.Schedule)</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Rota</dt>
                    <dd>@rota</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Descrição</dt>
                    <dd class="is-muted">@descricao</dd>
                </div>
            </dl>
        </section>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Situação do veículo</h2>
                    <partial name="_StatusBadge" model="Model.Status" />
                    <p class="mt-3 mb-0">
                        @if (string.Equals(Model.Status, "Operacional", StringComparison.OrdinalIgnoreCase))
                        {
                            <text>O veículo está disponível para a operação.</text>
                        }
                        else if (string.Equals(Model.Status, "Manutenção", StringComparison.OrdinalIgnoreCase))
                        {
                            <text>O veículo está sinalizado em manutenção e deve ser acompanhado antes de voltar à operação.</text>
                        }
                        else
                        {
                            <text>Confira o status informado antes de programar este veículo em uma viagem.</text>
                        }
                    </p>
                </div>
            </section>

            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Resumo</h2>
                    <dl class="ev-data ev-data--stacked">
                        <div class="ev-data__item">
                            <dt>Identificação</dt>
                            <dd>@identificacao</dd>
                        </div>
                        <div class="ev-data__item">
                            <dt>Ocupação máxima</dt>
                            <dd>@Model.Capacity pessoas</dd>
                        </div>
                    </dl>
                </div>
            </section>
        </aside>
    </div>
</section>
