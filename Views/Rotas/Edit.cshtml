@model EasyVan.Models.Rota

@{
    ViewData["Title"] = "Editar rota";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para rotas
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Rota #@Model.Id</p>
            <h1>Editar rota</h1>
            <p class="ev-page-head__lead">Atualize o trajeto, a descrição ou a situação desta rota.</p>
        </div>
    </header>

    <form asp-action="Edit" method="post" class="ev-form-layout">
        <div class="ev-form-main">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="ev-notice ev-notice--danger" role="alert"></div>

            <section class="ev-panel ev-form-section" aria-labelledby="trajeto">
                <div class="ev-form-section__head">
                    <h2 id="trajeto">Trajeto</h2>
                    <p>Nome da rota e os pontos de partida e chegada.</p>
                </div>
                <div class="ev-form-grid">
                    <div class="ev-field ev-field--full">
                        <label asp-for="Nome" class="form-label">Nome da rota <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="Origem" class="form-label">Origem <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Origem" class="form-control" />
                        <span asp-validation-for="Origem" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field">
                        <label asp-for="Destino" class="form-label">Destino <span class="ev-required" aria-hidden="true">*</span></label>
                        <input asp-for="Destino" class="form-control" />
                        <span asp-validation-for="Destino" class="ev-form-validation"></span>
                    </div>

                    <div class="ev-field ev-field--full">
                        <label asp-for="Descricao" class="form-label">Descrição</label>
                        <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Descricao" class="ev-form-validation"></span>
                    </div>
                </div>
            </section>

            <section class="ev-panel ev-form-section" aria-labelledby="situacao-rota">
                <div class="ev-form-section__head">
                    <h2 id="situacao-rota">Situação</h2>
                    <p>Controla se a rota pode ser usada em novas viagens.</p>
                </div>
                <div class="ev-check">
                    <input asp-for="Ativo" class="form-check-input" />
                    <div class="ev-check__text">
                        <label asp-for="Ativo">Rota ativa</label>
                        <span>Rotas inativas permanecem no histórico, mas não são oferecidas em novas viagens.</span>
                    </div>
                </div>
            </section>

            <div class="ev-form-actions">
                <button type="submit" class="btn btn-primary">Salvar alterações</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </div>

        <aside class="ev-form-aside">
            <section class="ev-panel">
                <div class="ev-panel__body">
                    <h2>Trajeto atual</h2>
                    <div class="ev-route-leg" aria-label="Trajeto cadastrado">
                        <span class="ev-route-leg__stop">@Model.Origem</span>
                        <partial name="_Icon" model='"arrow-right"' />
                        <span class="ev-route-leg__stop ev-route-leg__stop--end">@Model.Destino</span>
                    </div>
                </div>
            </section>
        </aside>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
