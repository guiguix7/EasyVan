@model IEnumerable<EasyVan.Models.Rota>

@{
    ViewData["Title"] = "Rotas";
    var rotas = Model.ToList();
    var ativas = rotas.Count(r => r.Ativo);
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Cadastros</p>
            <h1>Rotas</h1>
            <p class="ev-page-head__lead">Organize os trajetos e consulte origem, destino e situação de cada rota.</p>
        </div>
        <div class="ev-page-head__actions">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary">
                    <partial name="_Icon" model='"plus"' />
                    Nova rota
                </a>
            }
        </div>
    </header>

    @if (TempData["Erro"] is string erro) { <div class="ev-notice ev-notice--danger" role="alert">@erro</div> }
    @if (TempData["Sucesso"] is string sucesso) { <div class="ev-notice ev-notice--success" role="status">@sucesso</div> }

    @if (rotas.Any())
    {
        <div class="ev-results">
            <p class="mb-0">
                <strong>@rotas.Count</strong> rotas cadastradas · <strong>@ativas</strong> ativas.
            </p>
        </div>

        <section class="ev-panel ev-panel--flush ev-list-desktop" aria-label="Tabela de rotas">
            <div class="ev-table-scroll">
                <table class="ev-table">
                    <thead>
                        <tr>
                            <th scope="col">Rota</th>
                            <th scope="col">Origem</th>
                            <th scope="col">Destino</th>
                            <th scope="col">Descrição</th>
                            <th scope="col">Status</th>
                            <th scope="col"><span class="visually-hidden">Ações</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rota in rotas)
                        {
                            <tr>
                                <td>
                                    <span class="ev-table__primary">@rota.Nome</span>
                                    <span class="ev-table__secondary">Rota #@rota.Id</span>
                                </td>
                                <td>@rota.Origem</td>
                                <td>@rota.Destino</td>
                                <td>@(string.IsNullOrWhiteSpace(rota.Descricao) ? "—" : rota.Descricao)</td>
                                <td><partial name="_StatusBadge" model='rota.Ativo ? "Ativa" : "Inativa"' /></td>
                                <td class="is-actions">
                                    <div class="ev-row-actions">
                                        <a asp-action="Details" asp-route-id="@rota.Id" class="ev-link-action">Detalhes</a>
                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@rota.Id" class="ev-link-action">
                                                <partial name="_Icon" model='"edit"' />
                                                Editar
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@rota.Id" class="ev-link-action ev-link-action--danger">
                                                <partial name="_Icon" model='"trash"' />
                                                Excluir
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="ev-records ev-list-mobile" aria-label="Lista de rotas">
            @foreach (var rota in rotas)
            {
                <article class="ev-record">
                    <div class="ev-record__head">
                        <div>
                            <h2 class="ev-record__title">@rota.Nome</h2>
                            <span class="ev-record__meta">Rota #@rota.Id</span>
                        </div>
                        <partial name="_StatusBadge" model='rota.Ativo ? "Ativa" : "Inativa"' />
                    </div>
                    <div class="ev-route-leg" aria-label="Trajeto">
                        <span class="ev-route-leg__stop">@rota.Origem</span>
                        <partial name="_Icon" model='"arrow-right"' />
                        <span class="ev-route-leg__stop ev-route-leg__stop--end">@rota.Destino</span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(rota.Descricao))
                    {
                        <p class="mb-0 text-muted small">@rota.Descricao</p>
                    }
                    <div class="ev-record__actions">
                        <a asp-action="Details" asp-route-id="@rota.Id" class="btn btn-outline-primary">Detalhes</a>
                        @if (User.IsInRole("Administrador"))
                        {
                            <a asp-action="Edit" asp-route-id="@rota.Id" class="btn btn-outline-secondary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@rota.Id" class="btn btn-outline-danger">Excluir</a>
                        }
                    </div>
                </article>
            }
        </section>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
            <h2 class="ev-empty__title">Nenhuma rota cadastrada</h2>
            <p class="ev-empty__text">Crie uma rota para organizar os trajetos e associá-los às viagens.</p>
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Create" class="btn btn-primary">Cadastrar rota</a>
            }
        </div>
    }
</section>
