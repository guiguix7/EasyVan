@model EasyVan.Models.Rota

@{
    ViewData["Title"] = "Excluir rota";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para rotas
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Confirmação</p>
            <h1>Excluir rota</h1>
            <p class="ev-page-head__lead">Revise o trajeto antes de confirmar. A exclusão não pode ser desfeita.</p>
        </div>
    </header>

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="rota-exclusao">
            <div class="ev-panel__head">
                <div>
                    <h2 id="rota-exclusao">@Model.Nome</h2>
                    <p class="ev-panel__hint">Rota #@Model.Id</p>
                </div>
                <partial name="_StatusBadge" model='Model.Ativo ? "Ativa" : "Inativa"' />
            </div>
            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>Origem</dt>
                    <dd>@Model.Origem</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Destino</dt>
                    <dd>@Model.Destino</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Descrição</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Descricao) ? "Nenhuma descrição informada." : Model.Descricao)</dd>
                </div>
            </dl>
        </section>

        <aside>
            <div class="ev-notice ev-notice--danger" role="alert">
                <partial name="_Icon" model='"alert"' />
                <div class="ev-notice__body">
                    <p class="ev-notice__title">Esta ação é permanente</p>
                    <p class="mb-0">A rota será removida dos cadastros. Se houver viagens vinculadas, a exclusão pode ser impedida para preservar o histórico.</p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="ev-form-actions mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir definitivamente
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </aside>
    </div>
</section>
