@model EasyVan.Models.Rota

@{
    ViewData["Title"] = "Excluir Rota";
}

<section class="py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3">Excluir Rota</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Voltar à listagem</a>
    </div>

    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-danger text-center">
                <div class="card-body">
                    <div class="alert alert-danger mb-4">
                        <p>Tem certeza que deseja excluir a rota <strong>@Model.Nome</strong>?</p>
                        <p class="mb-0 text-muted">Esta ação não pode ser desfeita.</p>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-danger">Excluir</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
