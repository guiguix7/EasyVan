@model dynamic

@{
    ViewData["Title"] = "Minha van";
}

<section class="ev-page">
    <header class="ev-page-heading">
        <div>
            <h1>Minha van</h1>
            <p>Consulte as informações do veículo e os dados de transporte disponíveis.</p>
        </div>
        <div class="ev-page-actions">
            <a asp-controller="Home" asp-action="Aluno" class="btn btn-outline-secondary">Voltar ao início</a>
        </div>
    </header>

    @if (Model.Van != null)
    {
        <section class="ev-panel">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
                <div>
                    <span class="small text-muted">Identificação do veículo</span>
                    <h2 class="h3 mb-1">@Model.Van.Plate</h2>
                    <span class="small text-muted">Van #@Model.Van.Id</span>
                </div>
                <span class="badge @(Model.Van.Status == "Operacional" ? "badge-status-operacional" : Model.Van.Status == "Manutenção" ? "badge-status-manutencao" : "badge-status-outro")">
                    @Model.Van.Status
                </span>
            </div>

            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Rota</dt>
                <dd class="col-sm-9">@Model.Van.Route</dd>
                <dt class="col-sm-3 text-muted">Horários</dt>
                <dd class="col-sm-9">@Model.Van.Schedule</dd>
                <dt class="col-sm-3 text-muted">Capacidade</dt>
                <dd class="col-sm-9">@Model.Van.Capacity lugares</dd>
                <dt class="col-sm-3 text-muted">Motorista no cadastro</dt>
                <dd class="col-sm-9">@Model.MotoristaNome</dd>
                <dt class="col-sm-3 text-muted">Descrição</dt>
                <dd class="col-sm-9 mb-0">@Model.Van.Description</dd>
            </dl>
        </section>

        <p class="small text-muted mb-0">As informações exibidas correspondem ao veículo retornado pelo cadastro atual do sistema.</p>
    }
    else
    {
        <div class="ev-panel ev-empty" role="status">
            <h2 class="h5">Nenhuma van disponível</h2>
            <p class="mb-0">Não foi encontrada uma van para consulta neste momento.</p>
        </div>
    }
</section>
