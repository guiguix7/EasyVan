@model dynamic
@using EasyVan.Services

@{
    ViewData["Title"] = "Minha van";
    var vanAtual = Model.Van as EasyVan.Models.Van;
    var rota = Model.Rota as EasyVan.Models.Rota;
    var mapaVan = rota == null ? null : new EasyVan.Models.MapaRotaViewModel
    {
        Origem = rota.Origem,
        Destino = rota.Destino,
        Titulo = "Trajeto da van"
    };
}

<section class="ev-page">
    <a asp-controller="Home" asp-action="Aluno" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar ao início
    </a>

    @if (Model.Van != null)
    {
        <header class="ev-detail-head">
            <div>
                <p class="ev-eyebrow">Área do aluno · Minha van</p>
                <div class="ev-detail-head__identity">
                    <span class="ev-plate ev-plate--lg">@vanAtual!.Plate</span>
                    <partial name="_StatusBadge" model="vanAtual.Status" />
                </div>
                <p class="ev-detail-head__meta">
                    <partial name="_Icon" model='"route"' />
                    @VanUi.Rota(vanAtual)
                    <span aria-hidden="true">·</span>
                    <partial name="_Icon" model='"clock"' />
                    @(string.IsNullOrWhiteSpace(vanAtual.Schedule) ? "Horário não informado" : vanAtual.Schedule)
                </p>
            </div>
        </header>

        <div class="ev-detail-grid">
            <section class="ev-panel ev-panel--flush" aria-labelledby="dados-veiculo">
                <div class="ev-panel__head">
                    <div>
                        <h2 id="dados-veiculo">Dados do transporte</h2>
                        <p class="ev-panel__hint">Informações do veículo consultado.</p>
                    </div>
                </div>
                <dl class="ev-data">
                    <div class="ev-data__item">
                        <dt>Placa</dt>
                        <dd><span class="ev-plate">@vanAtual.Plate</span></dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Modelo</dt>
                        <dd>@(string.IsNullOrWhiteSpace(vanAtual.Modelo) ? "Modelo não informado" : vanAtual.Modelo)</dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Situação</dt>
                        <dd>@vanAtual.Status</dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Rota</dt>
                        <dd>@VanUi.Rota(vanAtual)</dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Horários</dt>
                        <dd>@(string.IsNullOrWhiteSpace(vanAtual.Schedule) ? "Não informados" : vanAtual.Schedule)</dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Capacidade</dt>
                        <dd>@vanAtual.Capacity lugares</dd>
                    </div>
                    <div class="ev-data__item">
                        <dt>Motorista</dt>
                        <dd>@(string.IsNullOrWhiteSpace((string)Model.MotoristaNome) ? "Não informado" : Model.MotoristaNome)</dd>
                    </div>
                    <div class="ev-data__item ev-data__item--wide">
                        <dt>Descrição</dt>
                        <dd>@(string.IsNullOrWhiteSpace(vanAtual.Description) ? "Sem descrição cadastrada." : vanAtual.Description)</dd>
                    </div>
                </dl>
            </section>

            <aside class="ev-form-aside">
                <section class="ev-panel">
                    <div class="ev-panel__body">
                        <h2>Sobre esta consulta</h2>
                        <p class="mb-0">As informações exibidas correspondem ao veículo retornado pelo cadastro atual do sistema. Se os dados não corresponderem ao seu transporte, procure a administração.</p>
                    </div>
                </section>

                <div class="ev-notice ev-notice--info mt-3" role="note">
                    <partial name="_Icon" model='"info"' />
                    <div class="ev-notice__body">
                        <p class="ev-notice__title">Horários podem mudar</p>
                        <p class="mb-0">Confirme a saída com o motorista ou com a operação antes de se deslocar.</p>
                    </div>
                </div>
            </aside>
        </div>

        @if (mapaVan != null)
        {
            <partial name="_MapaRota" model="mapaVan" />
        }
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"van"' /></span>
            <h1 class="ev-empty__title">Nenhuma van disponível</h1>
            <p class="ev-empty__text">Não foi encontrada uma van para consulta neste momento. Procure a administração da operação.</p>
            <a asp-controller="Home" asp-action="Aluno" class="btn btn-outline-secondary">Voltar ao início</a>
        </div>
    }
</section>
