@model dynamic

@{
    ViewData["Title"] = "Minha Van";
}

<section class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            @if (Model.Van != null)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-petroleo text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Minha Van</h5>
                        <span class="badge bg-light text-petroleo">Van #@Model.Van.Id</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <div class="d-flex align-items-center mb-3">
                                    <span class="badge badge-status-operacional fs-6 me-2">
                                        @(Model.Van.Status == "Operacional" ? "Disponível" : Model.Van.Status)
                                    </span>
                                    <strong>@Model.Van.Plate</strong>
                                </div>
                                <p class="mb-3"><strong>Rota:</strong> @Model.Van.Route</p>
                                <p class="mb-3"><strong>Horários:</strong> @Model.Van.Schedule</p>
                                <p class="mb-3"><strong>Capacidade:</strong> @Model.Van.Capacity alunos</p>
                                <p class="mb-3"><strong>Número:</strong> #@Model.Van.Id</p>
                            </div>
                        </div>

                        <div class="card border-0 shadow-sm mb-4">
                            <div class="card-body">
                                <h6 class="mb-3">Motorista responsável</h6>
                                <p><strong>@Model.MotoristaNome</strong></p>
                                <p class="text-muted small mb-0">Entre em contato com o motorista para informações sobre embarque e pontos de parada.</p>
                            </div>
                        </div>

                        <div class="alert alert-info">
                            <p class="mb-0 small">
                                @Model.Van.Description
                            </p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-warning text-center">
                    Nenhuma van encontrada para o seu perfil.
                </div>
            }
        </div>
    </div>
</section>
