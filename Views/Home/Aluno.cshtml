@model dynamic

@{
    ViewData["Title"] = "Início";
}

<section class="ev-page">
    <header class="ev-page-heading">
        <div>
            <h1>Olá, @User.Identity?.Name</h1>
            <p>Consulte as informações do seu transporte e encontre os dados da van disponíveis no sistema.</p>
        </div>
    </header>

    <section class="ev-panel" aria-labelledby="transporte-titulo">
        <h2 id="transporte-titulo" class="ev-panel__title">Informações de transporte</h2>
        <p class="text-muted mb-3">Acesse a consulta de veículo, rota, horários e motorista.</p>
        <a asp-controller="Home" asp-action="Detalhes" class="btn btn-primary">Consultar minha van</a>
    </section>
</section>
