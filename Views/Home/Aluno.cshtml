@model dynamic

@{
    ViewData["Title"] = "Minha Conta - Aluno";
}

<section class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-petroleo text-white">
                    <h5 class="mb-0">Bem-vindo, aluno!</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">Acesse suas informações de transporte abaixo.</p>

                    <div class="d-grid gap-3 mt-4">
                        <a asp-controller="Home" asp-action="Detalhes" class="btn btn-primary btn-lg">
                            <span class="me-2">🚌</span> Minha Van
                        </a>
                    </div>

                    <div class="alert alert-info mt-4">
                        <p class="mb-0 small">
                            Aqui você consulta sua van, horário, ponto de embarque e dados do motorista.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
