@{
    ViewData["Title"] = "Home do Aluno";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="mb-3">Bem-vindo, aluno!</h1>
            <p class="text-muted mb-4">Área com acesso limitado para consultar informações e acompanhar seu transporte.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Minhas informações</h5>
                        <p class="mb-0 text-muted">Visualize dados básicos e sua rota de transporte.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Horários</h5>
                        <p class="mb-0 text-muted">Consulte as viagens e os horários disponíveis.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
