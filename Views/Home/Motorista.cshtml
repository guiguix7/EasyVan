@model dynamic

@{
    ViewData["Title"] = "Meu painel";
    var alunos = Model?.Alunos as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var rotas = Model?.Rotas as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var totalAlunos = alunos.Count();
    var totalRotas = rotas.Count();

    string Iniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length == 1
            ? partes[0].Substring(0, 1).ToUpperInvariant()
            : (partes[0].Substring(0, 1) + partes[^1].Substring(0, 1)).ToUpperInvariant();
    }
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Área do motorista</p>
            <h1>Meu painel</h1>
            <p class="ev-page-head__lead">Acesse os dados do veículo, os alunos ativos e as rotas disponíveis para a operação.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-controller="Viagens" asp-action="Index" class="btn btn-primary">
                <partial name="_Icon" model='"trip"' />
                Ver viagens
            </a>
        </div>
    </header>

    @if (Model.Van != null)
    {
        <section class="ev-panel ev-panel--flush" aria-labelledby="van-atual">
            <div class="ev-detail-head ev-detail-head--panel">
                <div>
                    <p class="ev-eyebrow">Veículo de referência</p>
                    <div class="ev-detail-head__identity">
                        <span class="ev-plate ev-plate--lg">@Model.Van.Plate</span>
                        <partial name="_StatusBadge" model="Model.Van.Status" />
                    </div>
                    <p class="ev-detail-head__meta">
                        <partial name="_Icon" model='"route"' />
                        @(string.IsNullOrWhiteSpace((string)Model.Van.Route) ? "Rota não informada" : Model.Van.Route)
                        <span aria-hidden="true">·</span>
                        <partial name="_Icon" model='"clock"' />
                        @(string.IsNullOrWhiteSpace((string)Model.Van.Schedule) ? "Horário não informado" : Model.Van.Schedule)
                    </p>
                </div>
                <a asp-controller="Vans" asp-action="Details" asp-route-id="@Model.Van.Id" class="btn btn-outline-secondary">
                    Ver cadastro
                </a>
            </div>

            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>Capacidade</dt>
                    <dd>@Model.Van.Capacity lugares</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Motorista no cadastro</dt>
                    <dd>@(string.IsNullOrWhiteSpace((string)Model.Van.Driver) ? "Não informado" : Model.Van.Driver)</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Descrição</dt>
                    <dd>@(string.IsNullOrWhiteSpace((string)Model.Van.Description) ? "Sem descrição cadastrada." : Model.Van.Description)</dd>
                </div>
            </dl>
        </section>

        <div class="ev-metrics ev-metrics--three" aria-label="Resumo da operação">
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Capacidade</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"van"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.Van.Capacity</strong>
                <span class="ev-metric__hint">lugares na van</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Alunos ativos</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"students"' /></span>
                </div>
                <strong class="ev-metric__value">@totalAlunos</strong>
                <span class="ev-metric__hint">passageiros cadastrados</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Rotas ativas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
                </div>
                <strong class="ev-metric__value">@totalRotas</strong>
                <span class="ev-metric__hint">trajetos disponíveis</span>
            </article>
        </div>
    }
    else
    {
        <div class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"van"' /></span>
            <h2 class="ev-empty__title">Nenhuma van disponível</h2>
            <p class="ev-empty__text">Não há veículos cadastrados para exibição neste momento. Procure a administração da operação.</p>
        </div>
    }

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="alunos-ativos">
            <div class="ev-panel__head">
                <div>
                    <h2 id="alunos-ativos">Alunos ativos</h2>
                    <p class="ev-panel__hint">Passageiros disponíveis para as viagens.</p>
                </div>
                <span class="ev-count">@totalAlunos</span>
            </div>

            @if (alunos.Any())
            {
                <ul class="ev-attendance">
                    @foreach (var aluno in alunos)
                    {
                        <li class="ev-attendance__item">
                            <div class="ev-person">
                                <span class="ev-avatar" aria-hidden="true">@Iniciais((string)aluno.Nome)</span>
                                <div class="ev-person__meta">
                                    <span class="ev-person__name">@aluno.Nome</span>
                                    <span class="ev-person__sub">@aluno.Email</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace((string)aluno.Telefone))
                            {
                                <span class="ev-person__sub">@aluno.Telefone</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="ev-empty ev-empty--compact">
                    <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"students"' /></span>
                    <p class="ev-empty__title">Nenhum aluno ativo</p>
                    <p class="ev-empty__text">A lista será exibida quando houver passageiros cadastrados.</p>
                </div>
            }
        </section>

        <section class="ev-panel ev-panel--flush" aria-labelledby="rotas-ativas">
            <div class="ev-panel__head">
                <div>
                    <h2 id="rotas-ativas">Rotas ativas</h2>
                    <p class="ev-panel__hint">Trajetos que podem ser usados nas viagens.</p>
                </div>
                <span class="ev-count">@totalRotas</span>
            </div>

            @if (rotas.Any())
            {
                <ul class="ev-attendance">
                    @foreach (var rota in rotas)
                    {
                        <li class="ev-attendance__item">
                            <div class="ev-attendance__note">
                                <span class="ev-person__name">@rota.Nome</span>
                                <div class="ev-route-leg mt-1">
                                    <span class="ev-route-leg__stop">@rota.Origem</span>
                                    <partial name="_Icon" model='"arrow-right"' />
                                    <span class="ev-route-leg__stop ev-route-leg__stop--end">@rota.Destino</span>
                                </div>
                            </div>
                            <partial name="_StatusBadge" model='"Ativa"' />
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="ev-empty ev-empty--compact">
                    <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
                    <p class="ev-empty__title">Nenhuma rota ativa</p>
                    <p class="ev-empty__text">As rotas disponíveis aparecerão aqui.</p>
                </div>
            }
        </section>
    </div>
</section>
