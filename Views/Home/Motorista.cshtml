@{
    ViewData["Title"] = "Página do Motorista";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="mb-3">Painel do motorista</h1>
            <p class="text-muted mb-4">Acesso parcial para acompanhar passageiros, rotas e checklist da viagem.</p>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Rotas</h5>
                        <p class="mb-0 text-muted">Consulte as rotas atribuídas e a situação de cada viagem.</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="border rounded p-3 h-100">
                        <h5>Passageiros</h5>
                        <p class="mb-0 text-muted">Acompanhe a presença e os dados dos alunos transportados.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
