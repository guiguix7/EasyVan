@model EasyVan.Models.PainelMotoristaViewModel

@{
    ViewData["Title"] = "Meu painel";
    var proximas = Model.Viagens
        .Where(v => v.Viagem.Data >= Model.Hoje && v.Viagem.Status != "Finalizada")
        .ToList();
    var viagensHoje = Model.Viagens.Count(v => v.Viagem.Data == Model.Hoje && v.Viagem.Status != "Cancelada");
    var alunosPrevistos = proximas.Sum(v => v.Alunos.Count);
    var alunosConfirmados = proximas.Sum(v => v.Alunos.Count(a => a.StatusConfirmacao == true));

    string Iniciais(string? nome)
    {
        if (string.IsNullOrWhiteSpace(nome)) return "?";
        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return partes.Length == 1
            ? partes[0].Substring(0, 1).ToUpperInvariant()
            : (partes[0].Substring(0, 1) + partes[^1].Substring(0, 1)).ToUpperInvariant();
    }
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Área do motorista</p>
            <h1>Olá, @(Model.Motorista?.Nome ?? User.Identity?.Name)</h1>
            <p class="ev-page-head__lead">Acompanhe as suas viagens, os alunos confirmados e registre a presença a bordo.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-controller="Viagens" asp-action="Index" class="btn btn-outline-secondary">
                <partial name="_Icon" model='"trip"' />
                Todas as viagens
            </a>
        </div>
    </header>

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="ev-notice ev-notice--success" role="status">
            <partial name="_Icon" model='"check"' />
            <div class="ev-notice__body"><p class="mb-0">@sucesso</p></div>
        </div>
    }
    @if (TempData["Erro"] is string erro)
    {
        <div class="ev-notice ev-notice--danger" role="alert">
            <partial name="_Icon" model='"alert"' />
            <div class="ev-notice__body"><p class="mb-0">@erro</p></div>
        </div>
    }

    @if (Model.SemVinculo)
    {
        <section class="ev-panel ev-empty">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"driver"' /></span>
            <h2 class="ev-empty__title">Sua conta ainda não está vinculada</h2>
            <p class="ev-empty__text">Peça à administração para associar seu usuário ao cadastro de motorista. Enquanto isso, o painel fica sem viagens atribuídas a você.</p>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-outline-secondary">Como tratamos seus dados</a>
        </section>
    }
    else
    {
        <div class="ev-metrics ev-metrics--three" aria-label="Resumo das viagens">
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Próximas viagens</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"calendar"' /></span>
                </div>
                <strong class="ev-metric__value">@proximas.Count</strong>
                <span class="ev-metric__hint">atribuídas a você</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Viagens hoje</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"trip"' /></span>
                </div>
                <strong class="ev-metric__value">@viagensHoje</strong>
                <span class="ev-metric__hint">@Model.Hoje.ToString("dd/MM/yyyy")</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Alunos confirmados</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"students"' /></span>
                </div>
                <strong class="ev-metric__value">@alunosConfirmados</strong>
                <span class="ev-metric__hint">de @alunosPrevistos previstos</span>
            </article>
        </div>

        @if (Model.Viagens.Any())
        {
            <div class="ev-trip-list">
                @foreach (var item in Model.Viagens)
                {
                    var viagem = item.Viagem;
                    var hoje = viagem.Data == Model.Hoje;
                    var permitePresenca = viagem.Status == "EmAndamento" || (hoje && viagem.Status == "Agendada");

                    <section class="ev-panel ev-panel--flush" aria-labelledby="viagem-@viagem.Id">
                        <div class="ev-detail-head ev-detail-head--panel">
                            <div>
                                <p class="ev-eyebrow">
                                    @viagem.Data.ToString("dddd, dd 'de' MMMM", new System.Globalization.CultureInfo("pt-BR"))
                                    @if (hoje)
                                    {
                                        <span class="ev-badge ev-badge--brand ms-2">Hoje</span>
                                    }
                                </p>
                                <div class="ev-detail-head__identity">
                                    <h2 id="viagem-@viagem.Id">@(viagem.Rota?.Nome ?? "Rota não informada")</h2>
                                    <partial name="_StatusBadge" model="viagem.Status" />
                                </div>
                                
                                <p class="ev-detail-head__meta">
                                    <partial name="_Icon" model='"clock"' />
                                    @(viagem.HoraInicio?.ToString(@"hh\:mm") ?? "Horário não informado")
                                    @if (viagem.HoraFim.HasValue)
                                    {
                                        <text>–@viagem.HoraFim.Value.ToString(@"hh\:mm")</text>
                                    }
                                    <span aria-hidden="true">·</span>
                                    <partial name="_Icon" model='"van"' />
                                    @(viagem.Van?.Plate ?? "Van não informada")
                                    @if (!string.IsNullOrWhiteSpace(viagem.Van?.Route))
                                    {
                                        <text>— @viagem.Van.Route</text>
                                    }
                                </p>
                            </div>
                            <a asp-controller="Viagens" asp-action="Details" asp-route-id="@viagem.Id" class="btn btn-outline-secondary btn-sm">
                                Ver viagem
                            </a>
                        </div>

                        <div class="ev-panel__head">
                            <div>
                                <h3>Alunos da viagem</h3>
                                <p class="ev-panel__hint">Nome, local de embarque, horário e presença.</p>
                            </div>
                            <span class="ev-count">@item.Alunos.Count</span>
                        </div>

                        @if (item.Alunos.Any())
                        {
                            <ul class="ev-attendance">
                                @foreach (var aluno in item.Alunos)
                                {
                                    <li class="ev-attendance__item">
                                        <div class="ev-person">
                                            <span class="ev-avatar" aria-hidden="true">@Iniciais(aluno.Nome)</span>
                                            <div class="ev-person__meta">
                                                <span class="ev-person__name">@aluno.Nome</span>
                                                <span class="ev-person__sub">
                                                    <partial name="_Icon" model='"pin"' />
                                                    @(string.IsNullOrWhiteSpace(aluno.Endereco) ? "Local não informado" : aluno.Endereco)
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(aluno.Telefone))
                                                {
                                                    <span class="ev-person__sub">
                                                        <partial name="_Icon" model='"phone"' />
                                                        @aluno.Telefone
                                                    </span>
                                                }
                                            </div>
                                        </div>

                                        <div class="ev-attendance__actions">
                                            <span class="ev-person__sub">
                                                <partial name="_Icon" model='"clock"' />
                                                @(viagem.HoraInicio?.ToString(@"hh\:mm") ?? "Sem horário")
                                            </span>

                                            @if (aluno.StatusConfirmacao == true)
                                            {
                                                <span class="ev-badge ev-badge--success"><span class="ev-badge__dot" aria-hidden="true"></span>Confirmou</span>
                                            }
                                            else if (aluno.StatusConfirmacao == false)
                                            {
                                                <span class="ev-badge ev-badge--neutral"><span class="ev-badge__dot" aria-hidden="true"></span>Não vai</span>
                                            }
                                            else
                                            {
                                                <span class="ev-badge ev-badge--info"><span class="ev-badge__dot" aria-hidden="true"></span>Sem resposta</span>
                                            }

                                            @if (aluno.Presente)
                                            {
                                                <span class="ev-badge ev-badge--success"><span class="ev-badge__dot" aria-hidden="true"></span>Presente</span>
                                            }

                                            @if (permitePresenca)
                                            {
                                                <form asp-controller="Home" asp-action="MarcarPresenca" method="post">
                                                    <input type="hidden" name="viagemId" value="@viagem.Id" />
                                                    <input type="hidden" name="alunoId" value="@aluno.AlunoId" />
                                                    <input type="hidden" name="presente" value="@(aluno.Presente ? "false" : "true")" />
                                                    <button type="submit" class="btn @(aluno.Presente ? "btn-outline-secondary" : "btn-primary") btn-sm">
                                                        @(aluno.Presente ? "Desmarcar" : "Presente")
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="ev-empty ev-empty--compact">
                                <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"students"' /></span>
                                <p class="ev-empty__title">Nenhum aluno nesta viagem</p>
                                <p class="ev-empty__text">A lista de presença é criada ao cadastrar a viagem com alunos ativos.</p>
                            </div>
                        }
                    </section>
                }
            </div>
        }
        else
        {
            <section class="ev-panel ev-empty">
                <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"trip"' /></span>
                <h2 class="ev-empty__title">Nenhuma viagem atribuída</h2>
                <p class="ev-empty__text">Quando a administração criar uma viagem com você como motorista, ela aparecerá aqui.</p>
            </section>
        }
    }
</section>
