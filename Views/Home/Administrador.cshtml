@{
    ViewData["Title"] = "Painel do Administrador";
}

<div class="container py-5">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <h1 class="mb-3">Painel de administrador</h1>
            <p class="text-muted mb-4">Acesso total para gerenciar usuários, rotas e vans.</p>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Usuários</h5>
                        <p class="mb-0 text-muted">Gerencie alunos, motoristas e administradores.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Vans</h5>
                        <p class="mb-0 text-muted">Controle a frota, horários e disponibilidade dos veículos.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="border rounded p-3 h-100">
                        <h5>Relatórios</h5>
                        <p class="mb-0 text-muted">Acompanhe métricas, movimentações e status geral do sistema.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
