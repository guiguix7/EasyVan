@model EasyVan.Models.CentroOperacoesViewModel

@{
    ViewData["Title"] = "Centro de Operações";
}

<section class="ev-page">
    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Centro de Operações</p>
            <h1>Painel do Gestor</h1>
            <p class="ev-page-head__lead">Acompanhamento operacional em tempo real com dados da frota, viagens e alertas.</p>
        </div>
        <div class="ev-page-head__actions">
            <a asp-action="Index" asp-controller="Viagens" class="btn btn-primary">
                <partial name="_Icon" model='"trip"' />
                Nova viagem
            </a>
        </div>
    </header>

    @if (TempData["Sucesso"] is string sucesso)
    {
        <div class="ev-notice ev-notice--success" role="status">
            <partial name="_Icon" model='"check"' />
            <div class="ev-notice__body"><p class="mb-0">@sucesso</p></div>
        </div>
    }
    @if (TempData["Erro"] is string erro)
    {
        <div class="ev-notice ev-notice--danger" role="alert">
            <partial name="_Icon" model='"alert"' />
            <div class="ev-notice__body"><p class="mb-0">@erro</p></div>
        </div>
    }

    <!-- A. Visão geral -->
    <section class="ev-panel ev-panel--flush" aria-labelledby="visao-geral">
        <div class="ev-panel__head">
            <div>
                <h2 id="visao-geral">Visão geral da operação</h2>
                <p class="ev-panel__hint">Indicadores principais da frota e da equipe.</p>
            </div>
        </div>

        <div class="ev-metrics ev-metrics--five" aria-label="Resumo operacional">
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Vans totais</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"van"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.TotalVans</strong>
                <span class="ev-metric__hint">@Model.VansOperacionais operacionais · @Model.VansManutencao em manutenção</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Motoristas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"driver"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.TotalMotoristas</strong>
                <span class="ev-metric__hint">@Model.MotoristasAtivos ativos</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Alunos</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"students"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.TotalAlunos</strong>
                <span class="ev-metric__hint">@Model.AlunosAtivos ativos</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Rotas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.TotalRotas</strong>
                <span class="ev-metric__hint">@Model.RotasAtivas ativas</span>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Viagens hoje</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"calendar"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensHoje</strong>
                <span class="ev-metric__hint">agendadas para este dia</span>
            </article>
        </div>
    </section>

    <!-- B. Situação das viagens -->
    <section class="ev-panel ev-panel--flush" aria-labelledby="situacao-viagens">
        <div class="ev-panel__head">
            <div>
                <h2 id="situacao-viagens">Situação das viagens</h2>
                <p class="ev-panel__hint">Distribuição por estado do ciclo de vida.</p>
            </div>
        </div>

        <div class="ev-metrics ev-metrics--six" aria-label="Viagens por status">
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Planejadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"calendar"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensPlanejadas</strong>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Confirmadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"check"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensConfirmadas</strong>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Agendadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"clock"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensAgendadas</strong>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Em andamento</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"trip"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensEmAndamento</strong>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Finalizadas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"check"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensFinalizadas</strong>
            </article>
            <article class="ev-metric">
                <div class="ev-metric__top">
                    <span class="ev-metric__label">Canceladas</span>
                    <span class="ev-metric__icon" aria-hidden="true"><partial name="_Icon" model='"x"' /></span>
                </div>
                <strong class="ev-metric__value">@Model.ViagensCanceladas</strong>
            </article>
        </div>
    </section>

    <!-- C. Alertas operacionais -->
    <section class="ev-panel ev-panel--flush @(Model.TemAlertas ? "ev-panel--alertas" : "")" aria-labelledby="alertas">
        <div class="ev-panel__head">
            <div>
                <h2 id="alertas">Alertas operacionais</h2>
                <p class="ev-panel__hint">Inconsistências identificadas automaticamente no banco de dados.</p>
            </div>
            <span class="ev-badge @(Model.AlertasImpeditivos > 0 ? "ev-badge--warning" : "ev-badge--neutral")">
                @Model.TotalAlertas alerta(s)
            </span>
        </div>

        @if (!Model.TemAlertas)
        {
            <div class="ev-empty ev-empty--compact">
                <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"check"' /></span>
                <h3 class="ev-empty__title">Nenhum alerta operacional</h3>
                <p class="ev-empty__text">Todas as viagens, vans e motoristas estão consistentes.</p>
            </div>
        }
        else
        {
            <div class="ev-alertas-lista">
                @foreach (var alerta in Model.Alertas)
                {
                    <div class="ev-alerta @(alerta.Gravidade == "Impeditivo" ? "ev-alerta--impeditivo" : "ev-alerta--aviso")">
                        <div class="ev-alerta__tipo">
                            <span class="ev-badge @(alerta.Gravidade == "Impeditivo" ? "ev-badge--warning" : "ev-badge--info")">
                                @alerta.Tipo
                            </span>
                        </div>
                        <div class="ev-alerta__conteudo">
                            <h4 class="ev-alerta__titulo">@alerta.Titulo</h4>
                            <p class="ev-alerta__descricao">@alerta.Descricao</p>
                        </div>
                        <div class="ev-alerta__acao">
                            <span class="ev-alerta__gravidade @(alerta.Gravidade == "Impeditivo" ? "ev-alerta__gravidade--impeditivo" : "ev-alerta__gravidade--aviso")">
                                @alerta.Gravidade
                            </span>
                            <a asp-action="Details" asp-controller="Viagens" asp-route-id="@alerta.EntidadeId"
                               class="btn btn-outline-secondary btn-sm">
                                Ver registro
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <!-- D. Ações prioritárias -->
    <section class="ev-panel ev-panel--flush" aria-labelledby="acoes-prioritarias">
        <div class="ev-panel__head">
            <div>
                <h2 id="acoes-prioritarias">Ações prioritárias</h2>
                <p class="ev-panel__hint">Atalhos para corrigir problemas e acessar registros relacionados.</p>
            </div>
        </div>

        <div class="ev-acoes-grid">
            @if (Model.VansEmManutencao.Any())
            {
                <a asp-action="Index" asp-controller="Vans" class="btn btn-outline-secondary">
                    <partial name="_Icon" model='"wrench"' />
                    Vans em manutenção (@Model.VansEmManutencao.Count)
                </a>
            }
            @if (Model.ViagensEmAndamento > 0)
            {
                <a asp-action="Index" asp-controller="Viagens" class="btn btn-outline-secondary">
                    <partial name="_Icon" model='"trip"' />
                    Viagens em andamento (@Model.ViagensEmAndamento)
                </a>
            }
            @if (Model.AlertasImpeditivos > 0)
            {
                <a asp-action="Index" asp-controller="Viagens" class="btn btn-outline-secondary">
                    <partial name="_Icon" model='"alert"' />
                    Resolver alertas impeditivos (@Model.AlertasImpeditivos)
                </a>
            }
            <a asp-action="Index" asp-controller="Motoristas" class="btn btn-outline-secondary">
                <partial name="_Icon" model='"driver"' />
                Gerenciar motoristas
            </a>
            <a asp-action="Index" asp-controller="Alunos" class="btn btn-outline-secondary">
                <partial name="_Icon" model='"students"' />
                Gerenciar alunos
            </a>
            <a asp-action="Index" asp-controller="Rotas" class="btn btn-outline-secondary">
                <partial name="_Icon" model='"route"' />
                Gerenciar rotas
            </a>
        </div>
    </section>

    <!-- E. Atividade recente -->
    <section class="ev-panel ev-panel--flush" aria-labelledby="atividade-recente">
        <div class="ev-panel__head">
            <div>
                <h2 id="atividade-recente">Atividade recente</h2>
                <p class="ev-panel__hint">Últimas operações registradas no histórico de auditoria.</p>
            </div>
        </div>

        @if (!Model.AtividadeRecente.Any())
        {
            <div class="ev-empty ev-empty--compact">
                <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"clock"' /></span>
                <h3 class="ev-empty__title">Nenhuma atividade registrada</h3>
                <p class="ev-empty__text">As operações aparecerão aqui à medida que forem realizadas.</p>
            </div>
        }
        else
        {
            <table class="ev-table">
                <thead>
                    <tr>
                        <th>Data/Hora</th>
                        <th>Operação</th>
                        <th>Entidade</th>
                        <th>ID</th>
                        <th>Responsável</th>
                        <th>Descrição</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.AtividadeRecente)
                    {
                        <tr>
                            <td>@log.DataOperacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <span class="ev-badge ev-badge--info">@log.TipoOperacao</span>
                            </td>
                            <td>@log.Entidade</td>
                            <td>@log.EntidadeId</td>
                            <td>@(log.UsuarioNome ?? "Sistema")</td>
                            <td>@log.Descricao</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}