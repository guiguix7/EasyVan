@model EasyVan.Models.LoginViewModel

@{
    ViewData["Title"] = "Entrar";
}

<section class="ev-login-page">
    <div class="ev-login-layout">
        <div class="ev-login-aside">
            <a class="ev-login-brand" asp-controller="Home" asp-action="Index" aria-label="EasyVan — início">
                <img src="~/images/logo.png" alt="EasyVan — Gestão de Rotas e Vans" />
            </a>

            <div>
                <h1>O transporte organizado começa aqui.</h1>
                <p>Tenha as informações da operação em um só lugar. Acompanhe vans, motoristas, alunos, rotas e viagens com mais clareza no dia a dia.</p>
            </div>

            <span class="ev-login-note">Gestão de transporte por vans, sem complicação.</span>
        </div>

        <div class="ev-login-content">
            <h2>Acesse sua conta</h2>
            <p>Entre com seu e-mail e senha para continuar.</p>

            <form asp-controller="Usuarios" asp-action="Login" method="post" class="ev-login-form">
                <input type="hidden" asp-for="RememberMe" value="false" />

                <div asp-validation-summary="ModelOnly" class="ev-login-error" role="alert"></div>

                <div>
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" type="email"
                           placeholder="voce@exemplo.com" autocomplete="username"
                           inputmode="email" autocapitalize="none" spellcheck="false" />
                    <span asp-validation-for="Email" class="text-danger ev-form-validation"></span>
                </div>

                <div>
                    <label asp-for="Password" class="form-label">Senha</label>
                    <input asp-for="Password" class="form-control" type="password"
                           placeholder="Digite sua senha" autocomplete="current-password" />
                    <span asp-validation-for="Password" class="text-danger ev-form-validation"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Entrar na plataforma</button>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
