@model EasyVan.Models.LoginViewModel

@{
    ViewData["Title"] = "Easy Van - Login";
}

<section class="home-login-page d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg rounded-4 p-4">
        <div class="text-center mb-4">
            <h1 class="fw-bold">Easy Van</h1>
            <p class="text-muted mb-0">Acesse o painel de gerenciamento de vans</p>
        </div>

        <form asp-action="Index" method="post" class="login-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control" placeholder="Digite seu usuário" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Digite seu email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Digite sua senha"/>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <div class="mb-3 text-end">
                <a asp-controller="Home" asp-action="Pages" asp-route-id="cadastro" class="link-primary">Não tenho conta?</a>
            </div>
            <button type="submit" class="btn btn-primary w-100">Entrar</button>
        </form>

        <div class="mt-4 text-center text-muted small">
            <p class="mb-1">Ainda não tem conta? Solicite acesso ao administrador.</p>
            <p class="mb-0">&copy; 2026 Easy Van</p>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

        <div class="mt-4 text-center text-muted small">
            <p class="mb-1">Ainda não tem conta? Solicite acesso ao administrador.</p>
            <p class="mb-0">&copy; 2026 Easy Van</p>
        </div>
    </div>
</section>