@model EasyVan.Models.Usuarios

@{
    var autenticado = User.Identity?.IsAuthenticated == true;
    ViewData["Title"] = autenticado ? "Novo usuário" : "Criar cadastro";
}

@if (autenticado)
{
    <section class="ev-page">
        <header class="ev-page-head">
            <div class="ev-page-head__text">
                <p class="ev-eyebrow">Administração</p>
                <h1>Novo usuário</h1>
                <p class="ev-page-head__lead">Crie uma conta e defina o perfil de acesso. A senha é gravada com hash.</p>
            </div>
            <div class="ev-page-head__actions">
                <a asp-controller="Usuarios" asp-action="Index" class="btn btn-outline-secondary">
                    <partial name="_Icon" model='"back"' />
                    Voltar à lista
                </a>
            </div>
        </header>

        <div class="ev-form-layout">
            <section class="ev-panel ev-form-section" aria-labelledby="dados-conta">
                <div class="ev-form-section__head">
                    <h2 id="dados-conta">Dados da conta</h2>
                    <p>Nome, e-mail, perfil e senha inicial.</p>
                </div>
                <partial name="_FormCadastro" model="Model" />
            </section>

            <aside class="ev-form-aside">
                <section class="ev-panel">
                    <div class="ev-panel__body">
                        <h2>Perfis de acesso</h2>
                        <ul>
                            <li><strong>Aluno:</strong> consulta a própria van e o transporte.</li>
                            <li><strong>Motorista:</strong> acompanha e opera as viagens.</li>
                            <li><strong>Administrador:</strong> gerencia cadastros e contas.</li>
                        </ul>
                    </div>
                </section>
            </aside>
        </div>
    </section>
}
else
{
    <section class="ev-auth">
        <div class="ev-auth__shell">
            <aside class="ev-auth__aside">
                <a class="ev-auth__brand" asp-controller="Home" asp-action="Index" aria-label="EasyVan — início">
                    <img src="~/images/logo.png" alt="EasyVan — Gestão de Rotas e Vans" width="174" height="82" />
                </a>

                <div class="ev-auth__statement">
                    <h1>Uma operação organizada começa com acesso.</h1>
                    <p>Crie sua conta para consultar as informações de transporte disponíveis na plataforma.</p>
                </div>

                <p class="ev-auth__note mb-0">EasyVan · Gestão de transporte por vans.</p>
            </aside>

            <div class="ev-auth__panel">
                <h2 class="ev-auth__title">Criar cadastro</h2>
                <p class="ev-auth__lead">Preencha os dados para registrar uma conta.</p>

                <partial name="_FormCadastro" model="Model" />

                <div class="ev-auth__links">
                    <span>Já possui uma conta?</span>
                    <a asp-controller="Home" asp-action="Index">Entrar</a>
                </div>
            </div>
        </div>
    </section>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
