@model EasyVan.Models.Usuarios

@{
    ViewData["Title"] = "Cadastro";
}

<section class="ev-login-page">
    <div class="ev-login-layout">
        <div class="ev-login-aside">
            <a class="ev-login-brand" asp-controller="Home" asp-action="Index" aria-label="EasyVan — início">
                <img src="~/images/logo.png" alt="EasyVan — Gestão de Rotas e Vans" />
            </a>
            <div>
                <h1>Uma operação mais organizada começa com informação.</h1>
                <p>Crie seu acesso para consultar e organizar as informações de transporte disponíveis na plataforma.</p>
            </div>
            <span class="ev-login-note">EasyVan · Gestão de Rotas e Vans</span>
        </div>

        <div class="ev-login-content">
            <h2>Criar cadastro</h2>
            <p>Preencha os dados para registrar uma conta.</p>

            <form asp-controller="Usuarios" asp-action="Create" method="post" class="ev-login-form">
                <div asp-validation-summary="ModelOnly" class="ev-login-error" role="alert"></div>

                <div>
                    <label asp-for="Nome" class="form-label">Nome</label>
                    <input asp-for="Nome" class="form-control" placeholder="Seu nome completo" autocomplete="name" />
                    <span asp-validation-for="Nome" class="text-danger ev-form-validation"></span>
                </div>

                <div>
                    <label asp-for="Email" class="form-label">E-mail</label>
                    <input asp-for="Email" class="form-control" type="email" placeholder="voce@exemplo.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="text-danger ev-form-validation"></span>
                </div>

                <div>
                    <label asp-for="RoleManager" class="form-label">Perfil</label>
                    <select asp-for="RoleManager" class="form-select">
                        <option value="Aluno">Aluno</option>
                        <option value="Motorista">Motorista</option>
                        <option value="Administrador">Administrador</option>
                    </select>
                    <span asp-validation-for="RoleManager" class="text-danger ev-form-validation"></span>
                </div>

                <div>
                    <label asp-for="PasswordHasher" class="form-label">Senha</label>
                    <input asp-for="PasswordHasher" class="form-control" type="password"
                           placeholder="Crie uma senha" autocomplete="new-password" />
                    <span asp-validation-for="PasswordHasher" class="text-danger ev-form-validation"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Criar conta</button>
            </form>

            <div class="mt-4 text-center">
                <a asp-controller="Home" asp-action="Index" class="text-petroleo">Já possui uma conta? Entrar</a>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
