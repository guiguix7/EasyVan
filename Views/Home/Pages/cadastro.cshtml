@model EasyVan.Models.Usuarios

@{
    ViewData["Title"] = "Cadastro";
}

<section class="home-login-page d-flex align-items-center justify-content-center">
    <div class="login-card shadow-lg p-4 w-100" style="max-width: 480px;">
        <div class="text-center mb-4">
            <h1 class="fw-bold">Cadastro de usuário</h1>
            <p class="text-muted mb-0" asp-for="Description">Crie sua conta para usar o Easy Van</p>
        </div>

        <form asp-controller="Usuarios" asp-action="Create" method="post" class="login-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nome" class="form-label"></label>
                <input asp-for="Nome" class="form-control" placeholder="Digite seu usuário" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="Digite seu email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="PasswordHasher" class="form-label">Senha</label>
                <input asp-for="PasswordHasher" class="form-control" placeholder="Digite sua senha" />
                <span asp-validation-for="PasswordHasher" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Cadastrar</button>
        </form>

        <div class="mt-4 text-center text-muted small">
            <a asp-controller="Home" asp-action="Index" class="link-secondary">Voltar para login</a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
