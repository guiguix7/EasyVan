@model EasyVan.Models.HorarioRota
@using EasyVan.Services
@{ ViewData["Title"] = "Excluir agenda"; }
<section class="ev-page"><a asp-action="Index" class="ev-back"><partial name="_Icon" model='"back"' /> Voltar para agenda</a><header class="ev-page-head"><div class="ev-page-head__text"><p class="ev-eyebrow">Confirmação</p><h1>Excluir agenda?</h1><p class="ev-page-head__lead">Agendas associadas a viagens não podem ser excluídas.</p></div></header><section class="ev-panel"><dl class="ev-detail-grid"><div><dt>Rota</dt><dd>@Model.Rota?.Nome</dd></div><div><dt>Sentido</dt><dd>@Model.Sentido</dd></div><div><dt>Dias</dt><dd>@AgendaUi.FormatarDias(Model.DiasSemana)</dd></div><div><dt>Saída</dt><dd>@Model.HorarioSaida.ToString(@"hh\:mm")</dd></div></dl></section><form asp-action="Delete" method="post" class="ev-form-actions"><input type="hidden" name="id" value="@Model.Id" /><button type="submit" class="btn btn-danger">Excluir agenda</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></form></section>
