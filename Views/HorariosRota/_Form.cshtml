@model EasyVan.Models.HorarioRotaFormViewModel
@using EasyVan.Models
@{
    var dias = new[] { (1, "Domingo"), (2, "Segunda-feira"), (4, "Terça-feira"), (8, "Quarta-feira"), (16, "Quinta-feira"), (32, "Sexta-feira"), (64, "Sábado") };
}
<div class="ev-form-main">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="ev-notice ev-notice--danger" role="alert"></div>
    <section class="ev-panel ev-form-section"><div class="ev-form-grid">
        <div class="ev-field"><label asp-for="RotaId" class="form-label"></label><select asp-for="RotaId" asp-items="Model.Rotas" class="form-select"><option value="0">Selecione uma rota</option></select><span asp-validation-for="RotaId" class="ev-form-validation"></span></div>
        <div class="ev-field"><label asp-for="Sentido" class="form-label"></label><select asp-for="Sentido" asp-items="Model.Sentidos" class="form-select"></select><span asp-validation-for="Sentido" class="ev-form-validation"></span></div>
        <div class="ev-field"><label asp-for="HorarioSaida" class="form-label"></label><input asp-for="HorarioSaida" type="time" class="form-control" /><span asp-validation-for="HorarioSaida" class="ev-form-validation"></span></div>
        <div class="ev-field"><label asp-for="VanPadraoId" class="form-label"></label><select asp-for="VanPadraoId" asp-items="Model.Vans" class="form-select"><option value="">Sem van padrão</option></select><span asp-validation-for="VanPadraoId" class="ev-form-validation"></span></div>
    </div>
    <fieldset class="mt-3"><legend class="form-label">Dias da semana</legend><div class="d-flex flex-wrap gap-3">
        @foreach (var (valor, nome) in dias)
        {
            var id = $"dia-{valor}";
            <div class="form-check"><input class="form-check-input" type="checkbox" name="DiasSelecionados" id="@id" value="@valor" checked="@(Model.DiasSelecionados.Contains(valor))" /><label class="form-check-label" for="@id">@nome</label></div>
        }
    </div><span asp-validation-for="DiasSelecionados" class="ev-form-validation"></span></fieldset>
    <div class="ev-check mt-3"><input asp-for="Ativo" class="form-check-input" /><div class="ev-check__text"><label asp-for="Ativo">Agenda ativa</label><span>Agendas inativas permanecem no histórico.</span></div></div>
    </section>
    <div class="ev-form-actions"><button type="submit" class="btn btn-primary">Salvar agenda</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div>
</div>
