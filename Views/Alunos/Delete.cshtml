@model EasyVan.Models.Aluno

@{
    ViewData["Title"] = "Excluir aluno";
}

<section class="ev-page">
    <a asp-action="Index" class="ev-back">
        <partial name="_Icon" model='"back"' />
        Voltar para alunos
    </a>

    <header class="ev-page-head">
        <div class="ev-page-head__text">
            <p class="ev-eyebrow">Confirmação</p>
            <h1>Excluir aluno</h1>
            <p class="ev-page-head__lead">Revise o cadastro antes de confirmar. A exclusão não pode ser desfeita.</p>
        </div>
    </header>

    <div class="ev-detail-grid">
        <section class="ev-panel ev-panel--flush" aria-labelledby="aluno-exclusao">
            <div class="ev-panel__head">
                <div>
                    <h2 id="aluno-exclusao">@Model.Nome</h2>
                    <p class="ev-panel__hint">Aluno #@Model.Id</p>
                </div>
                <partial name="_StatusBadge" model='Model.Ativo ? "Ativo" : "Inativo"' />
            </div>
            <dl class="ev-data">
                <div class="ev-data__item">
                    <dt>E-mail</dt>
                    <dd>@Model.Email</dd>
                </div>
                <div class="ev-data__item">
                    <dt>Telefone</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Telefone) ? "Não informado" : Model.Telefone)</dd>
                </div>
                <div class="ev-data__item ev-data__item--wide">
                    <dt>Endereço</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.Endereco) ? "Não informado" : Model.Endereco)</dd>
                </div>
            </dl>
        </section>

        <aside>
            <div class="ev-notice ev-notice--danger" role="alert">
                <partial name="_Icon" model='"alert"' />
                <div class="ev-notice__body">
                    <p class="ev-notice__title">Esta ação é permanente</p>
                    <p class="mb-0">O aluno será removido dos cadastros. Registros de presença vinculados podem ser afetados.</p>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="ev-form-actions mt-3">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <partial name="_Icon" model='"trash"' />
                    Excluir definitivamente
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancelar</a>
            </form>
        </aside>
    </div>
</section>
