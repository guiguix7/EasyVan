@model EasyVan.Models.MapaRotaViewModel

@{
    var titulo = string.IsNullOrWhiteSpace(Model.Titulo) ? "Trajeto" : Model.Titulo;
    var idTituloMapa = $"mapa-rota-{Guid.NewGuid():N}";
    var waypoints = string.Join("%7C", Model.Paradas.Take(3).Select(Uri.EscapeDataString));
    var linkMapa = $"https://www.google.com/maps/dir/?api=1&origin={Uri.EscapeDataString(Model.Origem)}&destination={Uri.EscapeDataString(Model.Destino)}{(string.IsNullOrEmpty(waypoints) ? "" : "&waypoints=" + waypoints)}&travelmode=driving";
}

<section class="ev-panel ev-panel--flush ev-map-panel" aria-labelledby="@idTituloMapa">
    <div class="ev-panel__head">
        <div>
            <h2 id="@idTituloMapa">@titulo</h2>
            <p class="ev-panel__hint">Trajeto entre origem, @Model.Paradas.Count parada(s) com aluno confirmado e destino. Sem rastreamento em tempo real.</p>
        </div>
        @if (Model.TemTrajeto)
        {
            <a class="btn btn-outline-secondary btn-sm" href="@linkMapa" target="_blank" rel="noopener noreferrer">
                <partial name="_Icon" model='"pin"' />
                Abrir no Google Maps
                <span class="visually-hidden">(abre em nova aba)</span>
            </a>
        }
    </div>

    @if (!Model.TemTrajeto)
    {
        <div class="ev-empty ev-empty--compact">
            <span class="ev-empty__icon" aria-hidden="true"><partial name="_Icon" model='"route"' /></span>
            <h3 class="ev-empty__title">Trajeto nÃ£o informado</h3>
            <p class="ev-empty__text">A rota precisa de origem e destino para exibir o mapa.</p>
        </div>
    }
    else
    {
        <div class="ev-map" data-mapa-rota data-origem="@Model.Origem" data-destino="@Model.Destino" data-paradas="@System.Text.Json.JsonSerializer.Serialize(Model.Paradas)">
            <div class="ev-map__canvas" data-mapa-canvas role="img"
                 aria-label="Mapa do trajeto de @Model.Origem atÃ© @Model.Destino"></div>
            <div class="ev-map__fallback" data-mapa-fallback>
                <partial name="_Icon" model='"pin"' />
                <p class="ev-map__fallback-title">Mapa interativo indisponÃ­vel</p>
                <p class="ev-map__fallback-text">
                    O trajeto continua disponÃ­vel como texto e no link do Google Maps.
                    O mapa aparece quando a integraÃ§Ã£o estÃ¡ configurada e a API responde.
                </p>
                <p class="ev-map__fallback-route">
                    <span>@Model.Origem</span>
                    <partial name="_Icon" model='"arrow-right"' />
                    <span>@Model.Destino</span>
                </p>
            </div>
        </div>
    }
</section>
